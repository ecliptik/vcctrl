#!/usr/bin/env python3
"""vcctrl -- client for vcctrld. Runs on the Pi; talks to /run/vcctrl.sock.

The VM-side `vcctrl` is a shell wrapper that ssh's here and runs this. Keeping
all logic on this side is deliberate: timing (key dwell, event pacing) must
never cross the network, and it means moving Claude onto the Pi later changes
nothing but which wrapper you call.
"""

import json
import os
import socket
import sys
import time

SOCKET_PATH = "/run/vcctrl.sock"

USAGE = """usage: vcctrl <command> [args]

  status                    device paths, USB4VC hold state, LED state
  key <name>...             tap keys in sequence      (enter esc f1 a 1)
  type <text>               type literal text         (type "CD \\\\DOSKUTSU")
  hold <key> <ms>           press, dwell, release     (hold left 800)
  keydown <key>             press and hold, no release
  keyup <key>               release a key held by keydown
  release-all               release every key held by keydown
  combo <key>...            chord                     (combo ctrl alt delete)
                            Keys are pressed MODIFIERS FIRST whatever order
                            they are given in, and released in reverse. Order
                            is protocol: a chord whose modifier arrives after
                            its key is a keystroke with a modifier press after
                            it. The reply echoes the order actually sent.
  keymap                    the key names this daemon accepts, the modifier
                            order chords are sent in, and the alias table --
                            what the web KVM reads so there is one copy. It
                            does NOT say which keys reach the target; only a
                            sweep at the machine can (docs/WEBKVM.md 5.2).
  mouse move <dx> <dy>
  mouse click [left|right|middle]
  leds                      read PS/2 LED return channel
  ledwait [timeout_s]       block until LED state changes
  led-changes [n]           the last n LED transitions, newest first, with a
                            monotonic clock and the power epoch. Shows that an
                            intermittent LEFT A TRACE -- it does NOT establish
                            that a reading is current, because the byte arrives
                            only on a lock-key change, so an idle machine
                            publishes nothing.
  power [state|on|off|cycle]  smart-plug mains control for the target
  caps                      capability health (input, leds, power, ...)
  config [show|check [F]]   show: what the RUNNING daemon resolved at start,
                            with its source and any VCCTRL_* overrides.
                            check: validate a config FILE on disk. These are
                            different questions and disagree exactly when the
                            file was edited without restarting the daemon.
  board                     which USB4VC protocol board is installed, and
                            therefore which machine input reaches. Reports
                            unknown rather than guessing; never defaults to
                            IBM PC.
  video [state|acquire|release]
                            capture device. The daemon owns /dev/video0 for its
                            lifetime; `release` frees it for a tool that opens
                            the device directly.
  framestats [n]            duplicate-hash stats over the last n frames
  audio [state|acquire|release]
                            ALSA capture. The daemon owns hw:1,0 for its
                            lifetime; `release` frees it for a direct capture.
  level [ms]                mean/peak dBFS over the last ms, from the PCM ring
  powerlog [n]              append-only record of every mains action taken
  shot [--out F] [n]        one selected frame, or an explicit "no picture"
  lastgood [--out F]        the last frame that was positively picture, aged
                            --out is two-valued ON PURPOSE: either F is this
                            run's frame and the status is 0, or F does not
                            exist and the status is 1. On "no picture" an
                            existing F is REMOVED rather than left, so that
                            `vcctrl shot --out f.jpg; analyse f.jpg` cannot
                            analyse the previous run's frame believing it is
                            current.
  timeline                  index of every frame in the scrub buffer: seq,
                            timestamp, size. No pixels, so it is cheap enough
                            to poll and is how you find the seq to fetch.
  frame <seq> [--out F]     one frame by sequence number. RAW, and labelled
                            raw -- the daemon passes no judgement on whether
                            it is a picture. For a judged frame use `shot`.
  burst <n> [--out-dir D]   n raw frames at once, written as <seq>.jpg.
                            All or nothing: a burst with silent holes in it
                            looks like a complete capture and is not.
  pin [status|on|off]       stop the ring evicting frames while you examine
                            them. Without it the live stream overwrites the
                            frame you are looking at. Auto-releases after
                            300 s, so an interrupted script cannot wedge it.
  buffer [seconds]          read, or set, how much history the ring keeps
  verify-input              prove the input path by LED round trip. THE only
                            check that means the target answered -- every
                            other input status describes the Pi's own end of
                            the wire. Exit codes carry the reading:
                              0  the target answered
                              1  it did not          (a real fault)
                              2  could not look      (no LED channel on this
                                                      board, or unreadable)
                              3  the tool itself failed
  profile [set NAME|blaster VALUE|clear]
                            the target's boot profile, as a READING rather
                            than a status. It cannot be polled -- establishing
                            it means typing SET at a prompt -- so it carries
                            when it was taken and what took it. ANY reboot
                            forgets it, and forgotten means absent, not old:
                            a stale profile is the same string in the same
                            place with nothing to say the machine underneath
                            it changed. `blaster` is the only form that is a
                            measurement; `set` is an assertion and says so.
  stage-file PATH [NAME] [--replace]
                            put a local file in the queue for the next
                            transfer. Chunked, sha256-verified on arrival, and
                            it lands under a DOS 8.3 name -- see file-name.
                            Nothing is sent to the target: this stages it.
  file-queue [list|clear [NAME]]
                            what is staged. `clear` drops staged files and
                            leaves alone anything this tool did not put there.
  files                     can the attached machine be sent a file at all?
                            Answers with a WORD, not a boolean: available,
                            unsupported (a Macintosh has no packet driver --
                            working hardware, nothing to fix), unknown (which
                            machine IS this?), not-configured, unreachable
                            (the file server is not running) or unchecked
                            (the probe itself timed out). Those need different
                            things doing about them, so they stay apart.
  file-name NAME            what NAME becomes on the target. DOS 8.3 and
                            uppercase, and the rename happens here because the
                            target cannot rename in transit. Prints the notes
                            so a shortened name is seen before it is sent.
  file-bats [DIR]           print, or write into DIR, the two batch files
                            this rig's CF card needs -- VCGET.BAT and
                            VCCHK.BAT, carrying THIS rig's server address and
                            login. Generated rather than shipped, so the
                            address cannot drift from the one the daemon binds
                            and the liveness check dials. Prints how to get
                            them onto the card, and neither replaces GET.BAT:
                            that stays the known-good bootstrap and is the
                            only way to fix these two without a card swap.
  send-file (--return|--stay) [--dest DIR]
                            send everything staged to the target. REBOOTS it
                            twice and destroys its environment. Neither flag
                            is the default: --stay leaves the machine in NET,
                            which no measured run may start from, so a script
                            that does not say would leave the rig in a state
                            its author did not choose.
                            Returns at once -- watch it with file-status.
  file-status [n]           how the running transfer is getting on, with the
                            last n log lines. Exit codes once it has finished:
                              0  everything asked for was sent and verified
                              1  at least one file did not
                              2  what was sent verified, but work is left --
                                 cancelled, or stopped early. `remaining`
                                 names it.
                            Still running exits 0: nothing has failed yet.
                            The reboots are the wall clock; the transfers are
                            a small fraction of it.
  file-cancel               stop after the file in flight. NOT mid-transfer:
                            FTP.EXE on the target cannot be interrupted from
                            here, and between files is the only honest
                            boundary.
  file-list [--from DIR]    what the target's C:\\XFER\\OUT held WHEN IT WAS
                            LAST READ, with the age of that reading. Touches
                            nothing: reading that directory means rebooting
                            the machine, so this is the last answer rather
                            than a current one, and an unread directory is not
                            an empty one.
  file-refresh (--return|--stay) [--from DIR] [--already-net]
                            go and read C:\\XFER\\OUT. REBOOTS the target, and
                            the listing comes back as a FILE -- a DIR
                            redirected and sent over FTP -- because this
                            console reads 13,800 as 13,808. Returns at once;
                            watch it with file-status.
  get-file (--all | NAME...) (--return|--stay) [--paranoid]
                            [--from DIR] [--already-net]
                            fetch files out of C:\\XFER\\OUT. REBOOTS the
                            target. Reads the directory first and fetches only
                            what its own DIR lists, so a name that is not
                            there is refused here rather than typed at the
                            machine.
                            VERIFIED AGAINST THE CARD'S OWN SIZE, which is a
                            weaker claim than the upload path's byte-for-byte
                            one and is reported as `size` rather than being
                            called the same thing. Nothing on DOS 6.22 can
                            hash a file. --paranoid fetches each file twice
                            and compares the two, which proves the path is
                            repeatable and still not that either copy equals
                            what is on the card.
                            NOTHING IS DELETED FROM THE TARGET, ever.
                            --from names a different directory on the target
                            (default C:\\XFER\\OUT) -- this is how the harness
                            collects C:\\DOSKUTSU\\LOGS. It must be an absolute
                            DOS 8.3 path; anything a command line would eat is
                            refused rather than repaired, because the string is
                            typed at a machine with no quoting.
                            --already-net skips the REBOOT and not the PROOF:
                            the arrival gate still runs, so being wrong about
                            where the machine is costs a refusal rather than a
                            command typed into a profile with no network.
  pulled [list|clear [NAME]|save NAME --out F]
                            what has been fetched off the target and is
                            sitting on the daemon host. `save` writes one file
                            to a path of yours; `clear` drops what is here and
                            leaves alone anything it cannot account for.
  file-check [timeout]      the real check: is the file server actually
                            answering? Run this BEFORE a transfer, not after --
                            a dead server discovered post-reboot has cost two
                            minutes and the target's whole environment. Exit
                            codes as verify-input:
                              0  ready
                              1  the server is not answering  (start serve.sh)
                              2  could not look
                              3  this machine cannot receive files, or none
                                 is configured
  preflight [--no-input] [--as NAME]
                            ONE gate for "is this rig fit to run". Checks caps,
                            board, power, video, scrub ring, the input lock and
                            the input round trip, and names the check that
                            decided. Exit codes as verify-input:
                              0  fit to run
                              1  a real fault      (named in decided_by)
                              2  could not tell    (named in decided_by)
                              3  the tool failed
                            A list of five verbs gets skipped exactly when a
                            run is finally ready; a gate with an exit code
                            does not. --no-input skips the round trip, which
                            types.
                            SCOPE IS THE HARNESS, NOT THE TARGET. It answers
                            "can this rig drive the machine", never "is the
                            machine fit to be measured" -- graphics provider,
                            sound mode, boot profile. A fully green harness
                            has driven a misconfigured target for a whole
                            round. Passing this says nothing about that.
  record --out F.avi --since T|now [a] [b] [--clip]
                            the scrub buffer as an AVI, optionally from seq a
                            to seq b. Takes the pin for the copy and releases
                            it. Two-valued: either F is this run's buffer or F
                            does not exist -- a truncated AVI still plays and
                            would be read as evidence of what the screen did.
                            Reports `written` (frames in the file) separately
                            from `frames` (frames the ring held); the muxer
                            repeats a frame across a gap to preserve timing,
                            so they differ by exactly the stalls.

                            --since T  REQUIRED, and IS THE CALLER'S OWN START
                            TIME -- it is the difference between a dump of
                            whatever the ring holds and a recording of YOUR
                            run. Pass `--since now` at the start of a run and
                            keep the value, or a unix time. It was optional
                            once; that meant a dump bounded by the RING rather
                            than the thing that asked for it was one forgotten
                            flag away, silently -- GMQ3-glass.avi was 94.5%
                            byte-identical to the PREVIOUS cell's frames, and
                            an analysis of it produced a confident wrong
                            conclusion three cells later. `first_seq` and
                            `first_t` were in the meta the whole time; nothing
                            refused on them.

                            REFUSES with exit 4 when the window opens before
                            --since, naming how many frames are foreign and by
                            how long, rather than writing a file that looks
                            like yours.

                            --clip  take only your own frames instead of
                            refusing. Reports `clipped_frames` so a shortened
                            recording says so rather than quietly being short.
  events [since]            activity log since a sequence number
  activity                  what is running, for how long, and who holds input
  lock [status|acquire|release|break] --as NAME
                            input arbitration. Unheld by default; while held,
                            input from anyone else is refused. `break` takes it
                            by force and MARKS THE RUN TAINTED.

options:
  --pace <seconds>          inter-event gap (default 0.012)
  --as <name>               identify the caller to the input lock
"""


def call(req):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCKET_PATH)
    except OSError as exc:
        sys.stderr.write("cannot reach vcctrld at %s: %s\n" % (
            SOCKET_PATH, exc))
        sys.stderr.write("is it running?  sudo systemctl status vcctrld\n")
        return None
    s.sendall((json.dumps(req) + "\n").encode("utf-8"))
    buf = b""
    while b"\n" not in buf:
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf.decode("utf-8"))


def write_frame(resp, path):
    """Write the frame to `path`, or guarantee nothing stale is sitting there.

    Both halves matter. Writing through a temp file and renaming means a
    reader never sees a half-written JPEG; removing `path` on "no picture"
    means a reader never sees the LAST run's frame and takes it for this
    one. The second is the failure this repo keeps rediscovering under
    different names -- a sample that is real but no longer current -- and
    leaving the old file in place on a failed shot builds a trap for it.
    """
    import base64
    import os

    # A raw frame carries no picture judgement, deliberately -- `frame` and
    # `burst` are labelled raw precisely so a caller cannot mistake them for
    # something the daemon vouched for. Judging them by resp["picture"] would
    # report "no picture" for every raw frame ever fetched, since the key is
    # absent rather than false.
    have = ("jpeg" in resp) if resp.get("raw") else bool(resp.get("picture"))
    if not have:
        note = ""
        try:
            os.unlink(path)
            note = "; removed the stale %s" % path
        except FileNotFoundError:
            pass
        except OSError as exc:
            sys.stderr.write("could not remove %s: %s\n" % (path, exc))
            return 1
        sys.stderr.write("no picture: %s%s\n" % (
            resp.get("reason", "reason not given"), note))
        return 1

    tmp = path + ".part"
    try:
        with open(tmp, "wb") as fh:
            fh.write(base64.b64decode(resp["jpeg"]))
        os.replace(tmp, path)
    except OSError as exc:
        sys.stderr.write("could not write %s: %s\n" % (path, exc))
        return 1

    # The base64 is now in the file; echoing it too would bury the metadata
    # that says whether the frame is any good.
    meta = {k: v for k, v in resp.items() if k != "jpeg"}
    meta["out"] = path
    sys.stdout.write(json.dumps(meta, indent=2, sort_keys=True) + "\n")
    return 0



def write_burst(resp, outdir):
    """N raw frames into a directory, named by sequence number.

    Same two-valued rule as write_frame, extended to a set: either the
    directory holds this run's frames and the status is 0, or the directory is
    empty and the status is 1. A HALF-WRITTEN burst is the worst outcome --
    it looks like a complete capture with a gap in it, and nothing on disk
    says which frames are missing or why.
    """
    import base64
    import os

    frames = resp.get("frames") or []
    if not frames:
        sys.stderr.write("no frames returned; %s left empty\n" % outdir)
        return 1
    try:
        os.makedirs(outdir, exist_ok=True)
    except OSError as exc:
        sys.stderr.write("could not create %s: %s\n" % (outdir, exc))
        return 1

    written = []
    try:
        for fr in frames:
            name = os.path.join(outdir, "%012d.jpg" % int(fr["seq"]))
            tmp = name + ".part"
            with open(tmp, "wb") as fh:
                fh.write(base64.b64decode(fr["jpeg"]))
            os.replace(tmp, name)
            written.append(name)
    except (OSError, KeyError, ValueError) as exc:
        # Roll back rather than leave a partial set. See the docstring: a
        # burst with silent holes in it is worse than no burst.
        for n in written:
            try:
                os.unlink(n)
            except OSError:
                pass
        try:
            os.unlink(tmp)
        except (OSError, NameError):
            pass
        sys.stderr.write("burst failed partway (%s); removed the %d frame(s) "
                         "already written rather than leave a set with holes "
                         "in it\n" % (exc, len(written)))
        return 1

    meta = {k: v for k, v in resp.items() if k != "frames"}
    meta["out_dir"] = outdir
    meta["written"] = len(written)
    meta["seqs"] = [int(f["seq"]) for f in frames]
    sys.stdout.write(json.dumps(meta, indent=2, sort_keys=True) + "\n")
    return 0


def stage_file(path, as_name=None, replace=False):
    """Read a local file and hand it to the daemon in chunks.

    CHUNKED BECAUSE THE SIZE POLICY ADMITS FILES FAR LARGER THAN ONE MESSAGE
    SHOULD CARRY. The whole file base64'd into a single request would be a
    third larger again and held entirely in memory at both ends, on a Pi with
    under a gigabyte.

    The sha256 goes with the LAST chunk, so the daemon can verify what it
    assembled against what this read off disk. That check is the reason the
    later round trip means anything: the transfer's verification compares the
    target's copy against the staged copy, and if the staged copy were already
    wrong it would compare a wrong file against itself and pass.
    """
    import base64 as _b64
    import hashlib as _hl
    if not os.path.isfile(path):
        sys.stderr.write("stage-file: %s is not a file\n" % path)
        return 3
    total = os.path.getsize(path)
    name = as_name or os.path.basename(path)
    CHUNK = 4 * 1024 * 1024
    h = _hl.sha256()
    sent = 0
    try:
        with open(path, "rb") as f:
            while True:
                block = f.read(CHUNK)
                h.update(block)
                final = sent + len(block) >= total
                req = {"cmd": "file_stage", "name": name, "total": total,
                       "offset": sent,
                       "data": _b64.b64encode(block).decode("ascii"),
                       "final": final}
                if replace:
                    req["replace"] = True
                if final:
                    req["sha256"] = h.hexdigest()
                resp = call(req)
                if resp is None:
                    sys.stderr.write("stage-file: the daemon did not answer\n")
                    return 1
                if not resp.get("ok"):
                    sys.stderr.write("error: %s\n" % resp.get("error"))
                    # `why` distinguishes a caller mistake from a fault. A
                    # name that cannot be a DOS filename, a size over the
                    # ceiling and a name already staged are all things the
                    # CALLER must change -- exit 3. A short or mismatched
                    # transfer is a real failure -- exit 1.
                    return 3 if resp.get("why") in (
                        "bad-name", "too-large", "name-taken") else 1
                sent += len(block)
                if final:
                    sys.stdout.write(
                        json.dumps(resp, indent=2, sort_keys=True) + "\n")
                    return 0
                if not block:
                    # An empty read before `final` means the file shrank under
                    # us. Loud, because the declared total is now a lie and
                    # the daemon would reject the sha anyway.
                    sys.stderr.write("stage-file: %s shrank while reading\n"
                                     % path)
                    return 1
    except OSError as exc:
        sys.stderr.write("stage-file: %s\n" % exc)
        return 3


def save_pulled(name, path):
    """Write one already-pulled file onto the caller's disk, in chunks.

    THE MIRROR OF stage_file, AND THE SAME TWO-VALUED CONTRACT AS --out
    ELSEWHERE: either `path` holds this file and the status is 0, or `path`
    does not exist at all. A half-written file left behind after a failed
    read is the stale-frame trap in another costume -- a caller that does
    `vcctrl pulled save X --out f; analyse f` must not analyse the previous
    attempt's bytes believing they are this one's.

    Chunked because the size policy admits files far larger than one JSON
    message should carry. The sha the daemon recorded when it verified the
    file is checked against these bytes, so a truncated read here is caught
    rather than being handed over as a short file.
    """
    import base64 as b64
    import hashlib as hl

    class Reported(Exception):
        """Already explained on stderr. Raised to unwind, not to describe.

        NOT IOError, WHICH IS OSError ON PYTHON 3. Catching `(IOError,
        OSError)` and then asking `isinstance(exc, IOError)` to tell the two
        apart is a test that is always true -- so a real write failure, a full
        disk or a permission denied, would have unwound in complete silence
        and returned 1 with nothing said. A sentinel of our own cannot be
        confused with the operating system's.
        """

    tmp = path + ".part"
    h = hl.sha256()
    got, total, want = 0, None, None
    try:
        with open(tmp, "wb") as fh:
            while True:
                resp = call({"cmd": "file_pulled", "action": "read",
                             "name": name, "offset": got})
                if resp is None:
                    sys.stderr.write("pulled save: the daemon did not answer\n")
                    raise Reported()
                if not resp.get("ok"):
                    sys.stderr.write("error: %s\n" % resp.get("error"))
                    raise Reported()
                total = resp["total"]
                # THE DAEMON'S NAME, NOT THE ONE THAT WAS TYPED. It converts
                # to DOS 8.3 -- `scores.dat` and `SCORES.DAT` are the same
                # file there -- and matching the typed spelling against the
                # list below would quietly find nothing and SKIP the sha
                # check, which is a verification that disappears when the
                # caller uses lower case.
                name = resp.get("name") or name
                chunk = b64.b64decode(resp.get("data") or "")
                fh.write(chunk)
                h.update(chunk)
                got += len(chunk)
                if resp.get("eof"):
                    break
                if not chunk:
                    # NO PROGRESS AND NOT AT THE END. Looping here would spin
                    # forever on a file that shrank underneath the read.
                    sys.stderr.write("pulled save: %s stopped short at %d of "
                                     "%d bytes\n" % (name, got, total))
                    raise Reported()
        listed = call({"cmd": "file_pulled", "action": "list"}) or {}
        for rec in listed.get("pulled") or ():
            if rec["name"] == name:
                want = rec.get("sha256")
        if want and want != h.hexdigest():
            sys.stderr.write("pulled save: %s read back with a different "
                             "sha256 than the daemon recorded when it verified "
                             "it -- not written\n" % name)
            raise Reported()
        os.replace(tmp, path)
    except (Reported, OSError) as exc:
        # TWO-VALUED, ON EVERY PATH OUT. Either `path` holds this file and the
        # status is 0, or `path` does not exist -- a caller that does
        # `vcctrl pulled save X --out f; analyse f` must never analyse the
        # previous attempt's bytes believing they are this one's.
        for leftover in (tmp, path):
            try:
                os.unlink(leftover)
            except OSError:
                pass
        if not isinstance(exc, Reported):
            sys.stderr.write("pulled save: %s\n" % exc)
        return 1
    sys.stdout.write(json.dumps({"ok": True, "name": name, "bytes": got,
                                 "sha256": h.hexdigest(), "out": path},
                                indent=2, sort_keys=True) + "\n")
    return 0


def file_bats(out_dir=None):
    """Print or write the two BATs this rig's card needs.

    NOT ON THE WEB ALLOWLIST, and this is where that shows: they carry the FTP
    password in plaintext. It is plaintext on the CF card too and there is no
    way around that -- the card's BATs have always held it -- but a password
    already sitting on a card is a different exposure from one a web request
    hands out on demand.
    """
    resp = call({"cmd": "file_bats"})
    if resp is None:
        sys.stderr.write("file-bats: the daemon did not answer\n")
        return 1
    if not resp.get("ok"):
        sys.stderr.write("error: %s\n" % resp.get("error"))
        return 3
    bats = resp["bats"]
    if out_dir:
        if not os.path.isdir(out_dir):
            sys.stderr.write("file-bats: %s is not a directory\n" % out_dir)
            return 3
        for name, text in sorted(bats.items()):
            p = os.path.join(out_dir, name)
            # BINARY, so the CRLF the daemon put in survives. Opening in text
            # mode would translate them back on some platforms, and a DOS
            # batch file with LF endings fails in ways that read as a logic
            # bug rather than a formatting one.
            with open(p, "wb") as f:
                f.write(text.encode("ascii"))
            sys.stdout.write("wrote %s (%d bytes)\n" % (p, len(text)))
    else:
        for name, text in sorted(bats.items()):
            sys.stdout.write("----- %s -----\n%s\n" % (name, text))
    sys.stdout.write("\n")
    for line in resp.get("install") or ():
        sys.stdout.write("  %s\n" % line)
    return 0


def file_check_exit(resp):
    """Map the transfer's availability onto an exit code.

        0  the target can receive a file and the server answered
        1  the server is not answering    -- a real fault, and fixable in a
                                             shell: start serve.sh
        2  could not look                 -- the board is unidentified, or the
                                             probe itself timed out
        3  the tool refused before acting -- this machine has no way to receive
                                             a file, or none is configured

    `unsupported` is 3 and NOT 1. A Macintosh Plus with no packet driver has
    not failed at anything; the operation does not exist there, and a harness
    that treats it as a fault aborts on working hardware. That is the same
    argument verify_input_exit makes about LEDs, and it is the reason both
    need four codes rather than two.

    `unchecked` is 2 rather than 1 for the mirror-image reason: a probe that
    timed out is a statement about the probe. Reporting it as a dead server
    would send somebody to restart a service that was never down.
    """
    why = resp.get("why")
    if resp.get("ok"):
        sys.stdout.write(json.dumps(resp, indent=2, sort_keys=True) + "\n")
        return 0
    sys.stderr.write("error: %s\n" % resp.get("error"))
    if why == "unreachable":
        return 1
    if why in ("unknown", "unchecked"):
        return 2
    return 3


def verify_input_exit(resp):
    """Map the round trip onto an exit code a script can branch on.

        0  the target answered      -- the input path is proven
        1  it did not answer        -- a real fault
        2  could not look           -- no return channel on this board, or
                                       the LEDs are unreadable
        3  the tool itself failed

    Three states rather than two, for the reason everything else on this rig
    has three: "the Macintosh has no LED channel" and "the Gateway is not
    answering" are opposite facts, and a harness that treats could-not-look as
    a failure aborts on working hardware.
    """
    if not resp.get("ok"):
        sys.stderr.write("error: %s\n" % resp.get("error"))
        return 3
    verified = resp.get("verified")
    sys.stdout.write(json.dumps(resp, indent=2, sort_keys=True) + "\n")
    if verified is True:
        return 0
    if verified is False:
        return 1
    return 2



def write_avi(url_bytes, meta, path):
    """The buffer as an AVI, two-valued like every other --out here.

    Either `path` is this run's buffer and the status is 0, or `path` does not
    exist. Never a partial AVI: a truncated file still opens, still plays, and
    still looks like a recording -- so a caller would take a copy that lost
    half its frames as evidence of what the screen did.

    written != frames, and both are reported. The muxer preserves timing by
    REPEATING a frame across a gap where the ring was thinned, so the file
    holds more frames than the ring did. Reporting `written` as "frames
    captured" would overstate what was actually observed, and the difference
    is exactly the stalls -- which is the thing a crash investigation cares
    about most.
    """
    import os

    if not url_bytes:
        try:
            os.unlink(path)
        except (FileNotFoundError, OSError):
            pass
        sys.stderr.write("no buffer to record: %s\n"
                         % (meta.get("error") or "the ring is empty"))
        return 1

    tmp = path + ".part"
    try:
        with open(tmp, "wb") as fh:
            fh.write(url_bytes)
        os.replace(tmp, path)
    except OSError as exc:
        for p in (tmp, path):
            try:
                os.unlink(p)
            except (FileNotFoundError, OSError):
                pass
        sys.stderr.write("could not write %s: %s\n" % (path, exc))
        return 1

    out = dict(meta)
    out["out"] = path
    out["note"] = ("written=%s frames in the file, from frames=%s in the ring; "
                   "the difference is %s repeated to preserve timing across "
                   "gaps, NOT frames captured"
                   % (meta.get("written"), meta.get("frames"),
                      meta.get("repeated")))
    sys.stdout.write(json.dumps(out, indent=2, sort_keys=True) + "\n")
    return 0


def fetch_avi(first, last, since=None, clip=False):
    """Pull /buffer.avi over HTTPS. Returns (bytes|None, meta).

    Over HTTP rather than the unix socket because the AVI is tens of
    megabytes and the socket protocol here is line-delimited JSON -- base64ing
    60 MB through it would work and would be a poor idea.
    """
    import os
    import urllib.error
    import urllib.request

    # No hardcoded hostname; see docs/CONFIG-PLAN.md phase 3.
    base = os.environ.get("VCCTRL_WEB") or _cfg_get("control.web", "")
    q = []
    if first is not None:
        q.append("from=%d" % first)
    if last is not None:
        q.append("to=%d" % last)
    if since is not None:
        q.append("since=%f" % since)
    if clip:
        q.append("clip=1")
    url = "%s/buffer.avi%s" % (base, ("?" + "&".join(q)) if q else "")
    try:
        with urllib.request.urlopen(url, timeout=120) as r:
            data = r.read()
            raw = r.headers.get("X-Buffer-Meta") or "{}"
    except urllib.error.HTTPError as exc:
        return None, {"error": "HTTP %s from %s" % (exc.code, url)}
    except Exception as exc:
        return None, {"error": "%s: %s" % (type(exc).__name__, exc)}
    try:
        meta = json.loads(raw)
    except ValueError:
        meta = {}
    return data, meta



# --- preflight ------------------------------------------------------------
#
# One command, one exit code, and it NAMES the check that decided.
#
# The benchmarking session asked for this and the argument is the reason it
# exists rather than the feature: the check that would have saved their first
# Round P existed, was correctly specified, and was written into the run sheet
# the same day -- as a LIST. Lists get skipped at the moment a round is finally
# ready to run after a long preparation, which is exactly when they matter. A
# list of five verbs is a list. `vcctrl preflight` with an exit code is a gate.
#
# Every state here is three-valued, for the reason everything on this rig is:
# a check that cannot distinguish "this is broken" from "I could not tell" will
# eventually report one as the other, and the two demand opposite responses.

_VCCONFIG_TRIED = []


def _vcconfig():
    """Import vcconfig from wherever this copy of the client actually sits.

    THE DOCSTRING THIS REPLACES WAS WRONG, AND WRONG IN THE DIRECTION THAT
    HIDES. It claimed vcconfig sits "beside this file once installed
    ($PREFIX/vcconfig.py)". It does not: install.sh puts the library in
    $PREFIX (/opt/vcctrl) and the CLIENT in /usr/local/bin/vcctrl, so
    dirname(dirname(__file__)) is /usr/local and the lookup went to
    /usr/local/common/vcconfig.py -- which has never existed. `vcctrl config
    check` on the daemon host has therefore never worked.

    It went unnoticed because it FAILS SAFE: exit 3, "the tool could not run",
    never a claim that the configuration is bad. A wrong answer would have been
    found in a day; a refusal to answer sat there. Reported by the vcctrl
    session, who hit it from a fresh clone AND their own checkout and correctly
    concluded the rewrite was not the cause.

    Candidates in order, and the failure names every path tried, because a
    loader that cannot say where it looked sends the reader to the wrong file.
    """
    global _VCCONFIG_TRIED
    try:
        import vcconfig                      # already importable
        return vcconfig
    except ImportError:
        pass
    import importlib.util as _u
    here = os.path.dirname(os.path.abspath(__file__))
    cands = [
        os.path.join(os.path.dirname(here), "common", "vcconfig.py"),
        os.path.join(here, "vcconfig.py"),
        os.path.join(os.environ.get("VCCTRL_PREFIX", "/opt/vcctrl"),
                     "vcconfig.py"),
    ]
    _VCCONFIG_TRIED = cands
    for c in cands:
        if not os.path.exists(c):
            continue
        try:
            spec = _u.spec_from_file_location("vcconfig", c)
            mod = _u.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
        except Exception:
            continue
    return None


def _cfg_get(path, fallback=None):
    """One config value, or the fallback. Never raises, never blocks a verb.

    A CLI that cannot read its config must still run every command that does
    not need it.
    """
    mod = _vcconfig()
    if mod is None:
        return fallback
    try:
        return mod.load(strict=False).default(path, fallback)
    except Exception:
        return fallback


def config_check(path=None):
    """Validate a config file. Exit codes match verify-input's vocabulary:
    0 fine, 1 a real fault (the file is wrong), 3 the tool could not run."""
    mod = _vcconfig()
    if mod is None:
        sys.stderr.write("config check: cannot load the config module. Tried:\n")
        for c in _VCCONFIG_TRIED:
            sys.stderr.write("  %s\n" % c)
        return 3
    return mod.main(["config", "check", path] if path else ["config", "check"])


OK, FAULT, UNKNOWN = "ok", "fault", "unknown"


def _chk(name, state, detail):
    return {"check": name, "state": state, "detail": detail}


def preflight_checks(who=None, skip_input=False):
    """Ordered, cheapest first, and the one that TYPES comes last.

    Order is deliberate. Everything before verify-input is a read; if the rig
    is in no state to be typed at, we want to have found that out without
    having typed at it.
    """
    out = []

    caps = call({"cmd": "caps"}) or {}
    if not caps.get("ok") and "capabilities" not in caps:
        out.append(_chk("caps", UNKNOWN, "the daemon did not answer `caps`"))
    else:
        bad = sorted(k for k, v in (caps.get("capabilities") or {}).items()
                     if not v.get("ok"))
        out.append(_chk("caps", FAULT if bad else OK,
                        ("not healthy: %s" % ", ".join(bad)) if bad
                        else "all %d healthy" % len(caps.get("capabilities") or {})))

    board = (call({"cmd": "board"}) or {}).get("board") or {}
    if board.get("id") is None:
        out.append(_chk("board", UNKNOWN,
                        board.get("reason") or "no board reported"))
    else:
        out.append(_chk("board", OK, "%s -> %s"
                        % (board.get("name"), board.get("target"))))

    pw = (call({"cmd": "power", "action": "state"}) or {}).get("power") or {}
    on = pw.get("on") if "on" in pw else None
    if on is None:
        out.append(_chk("power", UNKNOWN,
                        "the plug did not report a state -- NOT the same as off"))
    elif on:
        out.append(_chk("power", OK, "on (%s)" % (pw.get("alias") or "plug")))
    else:
        out.append(_chk("power", FAULT, "the target is powered off"))

    vid = call({"cmd": "video", "action": "state"}) or {}
    st = vid.get("state")
    if st == "locked":
        out.append(_chk("video", OK, "locked, %s frames" % vid.get("frames")))
    elif st is None:
        out.append(_chk("video", UNKNOWN, "no video state reported"))
    elif not vid.get("device_present", True):
        out.append(_chk("video", FAULT, "the capture device is absent"))
    else:
        # Not locked is not necessarily broken -- a powered-off target has
        # nothing to lock onto -- so this is a could-not-look unless the
        # device itself is missing.
        out.append(_chk("video", UNKNOWN, "state is %r, not locked" % st))

    buf = call({"cmd": "buffer"}) or {}
    frames = buf.get("ring_frames")
    if frames is None:
        out.append(_chk("buffer", UNKNOWN, "no ring stats reported"))
    elif frames == 0:
        out.append(_chk("buffer", FAULT, "the scrub ring is empty"))
    else:
        out.append(_chk("buffer", OK, "%s frames, %ss span"
                        % (frames, buf.get("span_s"))))

    lock = call({"cmd": "lock", "action": "status"}) or {}
    owner = lock.get("owner")
    if owner and owner != who:
        out.append(_chk("lock", UNKNOWN,
                        "held by %r -- another session is driving" % owner))
        skip_input = True
    else:
        out.append(_chk("lock", OK,
                        "held by us (%s)" % who if owner else "free"))

    if skip_input:
        out.append(_chk("input", UNKNOWN,
                        "not attempted -- the input lock is held elsewhere"))
        return out

    req = {"cmd": "verify_input"}
    if who:
        req["as"] = who
    vi = call(req) or {}
    if not vi.get("ok"):
        out.append(_chk("input", UNKNOWN,
                        "verify_input failed: %s" % vi.get("error")))
    elif vi.get("verified") is True:
        out.append(_chk("input", OK, "the target acknowledged a keystroke"))
    elif vi.get("verified") is False:
        out.append(_chk("input", FAULT,
                        "no LED change -- the link is not carrying keystrokes"))
    else:
        out.append(_chk("input", UNKNOWN,
                        vi.get("reason") or "the round trip does not apply here"))
    return out


def preflight(who=None, skip_input=False):
    checks = preflight_checks(who, skip_input)
    faults = [c for c in checks if c["state"] == FAULT]
    unknowns = [c for c in checks if c["state"] == UNKNOWN]

    if faults:
        verdict, code, decided = FAULT, 1, faults[0]
    elif unknowns:
        verdict, code, decided = UNKNOWN, 2, unknowns[0]
    else:
        verdict, code, decided = OK, 0, None

    sys.stdout.write(json.dumps({
        "ok": True,
        "verdict": verdict,
        "exit": code,
        # THE SUBJECT OF THIS VERDICT, stated in the output because a bare
        # "ok" invites being read as "the rig is fit to run" and it is only
        # half of that. There are two preflights with different subjects:
        # this one asks whether the APPARATUS can drive the target, and a
        # separate target-readiness check asks whether the machine is fit to
        # be MEASURED. Passing one says nothing about the other.
        #
        # The benchmarking session has the receipt: a lost round this morning
        # had a completely healthy harness -- keystrokes landing, capture
        # locked, logs collected -- driving a target whose graphics provider
        # had silently failed to load. Seven green checks, fourteen wasted
        # minutes.
        "scope": "harness",
        "does_not_cover": ("whether the TARGET is fit to be measured -- its "
                           "graphics provider, sound mode and boot profile. "
                           "A green harness has driven a misconfigured target "
                           "for a full round before."),
        # Name the check that decided, so a 1 or a 2 points at a subsystem
        # instead of sending someone to read five statuses to find out which.
        "decided_by": decided["check"] if decided else None,
        "because": decided["detail"] if decided else None,
        "faults": [c["check"] for c in faults],
        "unknowns": [c["check"] for c in unknowns],
        "checks": checks,
    }, indent=2, sort_keys=True) + "\n")
    return code


def main(argv):
    pace = None
    who = None
    out = None
    out_dir = None
    # A recording's own start time, so the daemon can refuse a window that
    # opens before the run it claims to be of. `--since now` is the common
    # case: start the clock here, do the work, then record.
    since = None
    clip = False
    args = []
    i = 0
    while i < len(argv):
        if argv[i] == "--pace":
            pace = float(argv[i + 1])
            i += 2
            continue
        if argv[i] == "--as":
            who = argv[i + 1]
            i += 2
            continue
        if argv[i] == "--since":
            v = argv[i + 1]
            since = time.time() if v == "now" else float(v)
            i += 2
            continue
        if argv[i] == "--clip":
            clip = True
            i += 1
            continue
        if argv[i] == "--out":
            out = argv[i + 1]
            i += 2
            continue
        if argv[i] == "--out-dir":
            out_dir = argv[i + 1]
            i += 2
            continue
        args.append(argv[i])
        i += 1

    if not args or args[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0

    cmd, rest = args[0], args[1:]
    # Exit 3 rather than 2 here on purpose: 2 now means "could not look" for
    # verify-input, and a flag misapplied to a command is a tool misuse, not a
    # reading. Keeping them apart matters more than matching the old number,
    # which nothing branches on.
    if out is not None and cmd not in ("shot", "lastgood", "frame", "record",
                                      "pulled"):
        sys.stderr.write("--out applies to shot, lastgood, frame, record and "
                         "pulled, not %r\n" % cmd)
        return 3
    if out_dir is not None and cmd != "burst":
        sys.stderr.write("--out-dir applies to burst, not %r\n" % cmd)
        return 3
    if cmd == "preflight":
        return preflight(who=who, skip_input=("--no-input" in rest))

    if cmd == "record":
        if out is None:
            sys.stderr.write("record needs --out FILE\n")
            return 3
        if since is None:
            # OPEN-FAULTS.md sec 4: the refusal below this point only fires
            # when --since is actually given, so omitting it was a silent way
            # back into the exact hazard the refusal exists to catch --
            # GMQ3-glass.avi was 94.5% the PREVIOUS cell's frames, and nothing
            # here said so. The guard shipped opt-in and undiscoverable once
            # already (fixed 2026-08-23 by documenting it); an opt-in guard
            # that can still be silently skipped is the same defect one layer
            # up. The MCP tool (agent/vcctrl_mcp.py's vcctrl_record) already
            # makes `since` a required parameter for the same reason -- this
            # brings the CLI in line with it rather than leaving the CLI as
            # the one path where forgetting costs nothing until three cells
            # later.
            sys.stderr.write(
                "record needs --since T|now -- without it a dump is bounded "
                "by the ring, not by the run that asked for it. Pass "
                "`--since now` at the start of your run and keep the value, "
                "or a unix time if you already have one.\n")
            return 3
        first = int(rest[0]) if len(rest) > 0 else None
        last = int(rest[1]) if len(rest) > 1 else None
        # Take the pin for the duration. The muxer snapshots the ring under
        # the lock in one list(), so the pin is belt on top of braces rather
        # than the load-bearing part -- but it costs nothing, it makes the
        # two-valued contract easy to reason about, and the daemon expires it
        # by itself after 300 s if this process dies holding it.
        # Under our own name, so releasing it at the end drops OUR lease and
        # not a KVM reviewer's -- the ring is shared and the old unnamed
        # release took everyone's.
        me = "record-%d" % os.getpid()
        pinned = call({"cmd": "pin", "action": "on", "holder": me}) or {}
        try:
            data, meta = fetch_avi(first, last, since=since, clip=clip)
            if data is None and meta.get("refused") == "window_precedes_caller":
                # Say what is wrong and how to proceed, on stderr, rather than
                # a bare failure. This refusal exists because a recording that
                # silently contained the previous cell's frames produced a
                # confident, wrong conclusion three cells later.
                sys.stderr.write(
                    "refused: the buffer opens %.3fs before --since, so %d of "
                    "%d frames belong to whatever ran before.\n"
                    "  first_t %.3f   since %.3f   seqs %s..%s\n"
                    "  re-run with --clip to take only your own frames.\n"
                    % (meta.get("older_by_s", 0), meta.get("foreign_frames", 0),
                       meta.get("frames", 0), meta.get("first_t", 0),
                       meta.get("since", 0), meta.get("first_seq"),
                       meta.get("last_seq")))
                return 4
            return write_avi(data, meta, out)
        finally:
            if pinned.get("ok"):
                call({"cmd": "pin", "action": "off", "holder": me})

    if cmd == "status":
        req = {"cmd": "status"}
    elif cmd == "key":
        req = {"cmd": "key", "keys": rest}
    elif cmd == "type":
        req = {"cmd": "type", "text": " ".join(rest)}
    elif cmd == "hold":
        req = {"cmd": "hold", "key": rest[0],
               "ms": float(rest[1].rstrip("ms") or 0)}
    elif cmd == "combo":
        # accept "ctrl alt delete" or "ctrl-alt-delete"
        keys = rest if len(rest) > 1 else rest[0].split("-")
        req = {"cmd": "combo", "keys": keys}
    elif cmd == "mouse":
        if not rest:
            sys.stderr.write(USAGE)
            return 2
        if rest[0] == "move":
            req = {"cmd": "mouse_move", "dx": int(rest[1]),
                   "dy": int(rest[2])}
        elif rest[0] == "click":
            req = {"cmd": "mouse_click",
                   "button": rest[1] if len(rest) > 1 else "left"}
        else:
            sys.stderr.write(USAGE)
            return 2
    elif cmd == "keydown":
        req = {"cmd": "keydown", "key": rest[0]}
    elif cmd == "keyup":
        req = {"cmd": "keyup", "key": rest[0]}
    elif cmd in ("release-all", "release_all"):
        req = {"cmd": "release_all"}
    elif cmd == "caps":
        req = {"cmd": "caps"}
    elif cmd == "keymap":
        req = {"cmd": "keymap"}
    elif cmd == "config":
        # `config show` asks the RUNNING DAEMON what it resolved. `config
        # check` parses the file on disk, which is a different question --
        # they disagree exactly when someone edited the file without
        # restarting, which is the moment the difference matters most.
        sub = rest[0] if rest else "show"
        if sub == "check":
            return config_check(rest[1] if len(rest) > 1 else None)
        if sub != "show":
            sys.stderr.write("usage: vcctrl config [show|check [FILE]]\n")
            return 3
        req = {"cmd": "config"}
    elif cmd == "board":
        req = {"cmd": "board"}
    elif cmd == "events":
        req = {"cmd": "events", "since": int(rest[0]) if rest else 0}
    elif cmd == "activity":
        req = {"cmd": "activity"}
    elif cmd == "video":
        req = {"cmd": "video", "action": rest[0] if rest else "state"}
    elif cmd == "framestats":
        req = {"cmd": "framestats", "n": int(rest[0]) if rest else 90}
    elif cmd == "shot":
        req = {"cmd": "shot", "n": int(rest[0]) if rest else 16}
    elif cmd == "lastgood":
        req = {"cmd": "lastgood"}
    elif cmd == "audio":
        req = {"cmd": "audio", "action": rest[0] if rest else "state"}
    elif cmd == "level":
        req = {"cmd": "level", "ms": int(rest[0]) if rest else 3000}
    elif cmd == "powerlog":
        req = {"cmd": "powerlog", "n": int(rest[0]) if rest else 50}
    elif cmd == "lock":
        req = {"cmd": "lock", "action": rest[0] if rest else "status"}
    elif cmd == "leds":
        req = {"cmd": "leds"}
    elif cmd == "power":
        action = rest[0] if rest else "state"
        req = {"cmd": "power", "action": action}
        if action == "cycle" and len(rest) > 1:
            req["off_seconds"] = float(rest[1])
    elif cmd == "timeline":
        req = {"cmd": "timeline"}
    elif cmd == "frame":
        if not rest:
            sys.stderr.write("frame needs a sequence number "
                             "(see `vcctrl timeline`)\n")
            return 3
        req = {"cmd": "frame", "seq": int(rest[0])}
    elif cmd == "burst":
        req = {"cmd": "burst", "n": int(rest[0]) if rest else 8}
    elif cmd == "pin":
        # `pin on NAME` takes a lease of your own; `pin off NAME` drops just
        # that one. Bare `pin off` clears every holder, which is what you want
        # when you are at a terminal getting the ring moving again.
        req = {"cmd": "pin", "action": rest[0] if rest else "status"}
        if len(rest) > 1:
            req["holder"] = rest[1]
    elif cmd == "buffer":
        req = {"cmd": "buffer"}
        if rest:
            req["seconds"] = float(rest[0])
    elif cmd in ("led-changes", "led_changes"):
        req = {"cmd": "led_changes", "n": int(rest[0]) if rest else 50}
    elif cmd == "profile":
        req = {"cmd": "profile", "action": rest[0] if rest else "state"}
        if len(rest) > 1:
            req["name" if rest[0] == "set" else "value"] = rest[1]
    elif cmd in ("file-queue", "file_queue"):
        req = {"cmd": "file_queue", "action": rest[0] if rest else "list"}
        if len(rest) > 1:
            req["name"] = rest[1]
    elif cmd in ("stage-file", "file_stage"):
        if not rest:
            sys.stderr.write("stage-file needs a local file to stage\n")
            return 3
        return stage_file(rest[0], rest[1] if len(rest) > 1 else None,
                          replace="--replace" in argv)
    elif cmd == "files":
        req = {"cmd": "files"}
    elif cmd in ("file-name", "file_name"):
        if not rest:
            sys.stderr.write("file-name needs a filename to convert\n")
            return 3
        req = {"cmd": "file_name", "name": rest[0]}
    elif cmd in ("send-file", "file_send"):
        req = {"cmd": "file_send"}
        if "--stay" in argv:
            req["return"] = False
        elif "--return" in argv:
            req["return"] = True
        else:
            # NEITHER IS THE DEFAULT. NET loads the ODI stack as TSRs and the
            # standing rule is never load TSRs and measure in the same boot,
            # so a script that does not say leaves the rig in a state its
            # author did not think about -- which is exactly how a cell died
            # with no BLASTER after a hand-run transfer.
            sys.stderr.write(
                "send-file needs --return or --stay.\n"
                "  --return  reboot back to the menu default afterwards\n"
                "  --stay    leave the machine in NET (NO measured run may\n"
                "            start from there)\n")
            return 3
        for i, a in enumerate(rest):
            if a == "--dest" and i + 1 < len(rest):
                req["dest"] = rest[i + 1]
    elif cmd in ("file-list", "file_listing"):
        req = {"cmd": "file_listing"}
        for i, a in enumerate(rest):
            if a == "--from" and i + 1 < len(rest):
                req["dir"] = rest[i + 1]
    elif cmd in ("file-refresh", "get-file", "file_pull"):
        # THE SAME RULE AS send-file, AND FOR THE SAME REASON. Both reboot the
        # target; --stay leaves it in NET, where the ODI stack is resident and
        # no measured run may start. A script that does not say would leave
        # the rig in a state its author did not choose.
        req = {"cmd": "file_pull"}
        if "--stay" in argv:
            req["return"] = False
        elif "--return" in argv:
            req["return"] = True
        else:
            sys.stderr.write(
                "%s needs --return or --stay.\n"
                "  --return  reboot back to the menu default afterwards\n"
                "  --stay    leave the machine in NET (NO measured run may\n"
                "            start from there)\n" % cmd)
            return 3
        # WHICH DIRECTORY ON THE TARGET, and it is validated by the daemon
        # rather than here: the string is about to be typed at a machine with
        # no quoting, so the check belongs beside the thing that types it.
        for i, a in enumerate(rest):
            if a == "--from" and i + 1 < len(rest):
                req["dir"] = rest[i + 1]
        # SKIPS THE REBOOT, NOT THE PROOF. The arrival gate still runs, so a
        # caller who is wrong about where the machine is gets a refusal rather
        # than a fetch typed into a profile with no network stack.
        if "--already-net" in argv:
            req["already_net"] = True
        if cmd == "file-refresh":
            req["refresh"] = True
        else:
            skip = set()
            for i, a in enumerate(rest):
                if a == "--from":
                    skip.add(i + 1)
            names = [a for i, a in enumerate(rest)
                     if not a.startswith("-") and i not in skip]
            if "--all" in argv:
                req["all"] = True
            elif not names:
                sys.stderr.write(
                    "get-file needs --all or one or more names.\n"
                    "  `vcctrl file-list` says what the last reading found;\n"
                    "  `vcctrl file-refresh` goes and takes a new one.\n")
                return 3
            req["names"] = names
            req["paranoid"] = "--paranoid" in argv
    elif cmd == "pulled":
        action = rest[0] if rest else "list"
        if action == "save":
            if len(rest) < 2:
                sys.stderr.write("pulled save needs a name "
                                 "(see `vcctrl pulled list`)\n")
                return 3
            if out is None:
                sys.stderr.write("pulled save needs --out FILE to write to\n")
                return 3
            return save_pulled(rest[1], out)
        req = {"cmd": "file_pulled", "action": action}
        if len(rest) > 1:
            req["name"] = rest[1]
    elif cmd in ("file-bats", "file_bats"):
        return file_bats(rest[0] if rest and not rest[0].startswith("-")
                         else None)
    elif cmd in ("file-status", "file_status"):
        req = {"cmd": "file_status", "log": int(rest[0]) if rest and
               rest[0].isdigit() else 40}
    elif cmd in ("file-cancel", "file_cancel"):
        req = {"cmd": "file_cancel"}
    elif cmd in ("file-check", "file_check"):
        req = {"cmd": "file_check"}
        if rest:
            req["timeout"] = float(rest[0])
    elif cmd in ("verify-input", "verify_input"):
        req = {"cmd": "verify_input"}
    elif cmd == "ledwait":
        req = {"cmd": "ledwait",
               "timeout": float(rest[0]) if rest else 5.0}
    else:
        sys.stderr.write(USAGE)
        return 2

    if pace is not None:
        req["pace"] = pace
    if who is not None:
        req["as"] = who

    resp = call(req)
    if resp is None:
        return 3 if cmd in ("verify-input", "verify_input",
                            "file-check", "file_check") else 1
    if cmd in ("verify-input", "verify_input"):
        return verify_input_exit(resp)
    if cmd in ("file-check", "file_check"):
        return file_check_exit(resp)
    if cmd in ("file-status", "file_status"):
        j = resp.get("job") or {}
        sys.stdout.write(json.dumps(resp, indent=2, sort_keys=True) + "\n")
        if j.get("running") or j.get("ok") is None:
            return 0
        # A CANCELLED RUN IS NOT A FAILED ONE AND IS NOT A FINISHED ONE.
        # `ok` says every file attempted succeeded; `complete` says everything
        # asked for was done. A script that cancelled still wants to know work
        # is outstanding, and one that did not wants to know it stopped early.
        if not j.get("ok"):
            return 1
        return 0 if j.get("complete") else 2
    if not resp.get("ok"):
        sys.stderr.write("error: %s\n" % resp.get("error"))
        return 1
    if out is not None:
        return write_frame(resp, out)
    if out_dir is not None:
        return write_burst(resp, out_dir)
    if len(resp) > 1:
        sys.stdout.write(json.dumps(resp, indent=2, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
