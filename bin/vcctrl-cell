#!/usr/bin/env python3
"""vcctrl-cell -- run ONE doskutsu cell by hand, with the checks that matter.

Not a sweep runner. This is for the diagnostic single cells that the campaign
actually needed most often -- try a lever, look at the screen, get one number.
Every guard here exists because its absence cost a run on 2026-08-19.

WHAT WENT WRONG, AND WHAT EACH GUARD ANSWERS

1. `COPY CFGS\\OPL3.CFG DOSKUTSU.CFG` PROMPTS to overwrite. The prompt ate the
   first character of the NEXT typed command, and the rest of that line was
   lost -- so DOSKUTSU_TAS_REPLAY was never set, no reel drove the game, and
   the cell sat on the title screen until it was power-cycled. The `> NUL`
   redirect does not suppress a prompt; it only hides the copy's own output.
   Guard: answer the prompt explicitly, and set every variable BEFORE the copy
   so a stray prompt cannot swallow one.

2. "The prompt came back" is not "the command worked." A failed SET returns to
   the prompt exactly like a successful one. Three cells were lost to a check
   that could only ever return one answer.
   Guard: read the environment back and PARSE it, rather than screenshotting
   it and trusting a human to look. The screenshot was taken and not read.

3. A cell that dies instantly and a cell that runs for 149 s are the same
   observation behind a fixed wait.
   Guard: confirm the machine is NOT at a prompt shortly after launch.

4. Two scripts polling at_prompt at once corrupt each other -- each toggles
   Caps Lock, which is the signal the other is reading.
   Guard: a lock file. This refuses to run rather than interleave.

Usage:
  vcctrl-cell <TAG> --card mach64|virge|cirrus [--set VAR=VAL]...
                    [--forbid VAR]... [--ticks N] [--cfg NAME]
                    [--shot-at S] [--hw LIST]

  --forbid  a variable that MUST NOT be set. Verified POSITIVELY by reading
            a count of 0 back off the screen -- an unreadable answer refuses,
            because could-not-look is not absence. The presence gate counts
            variables and so can never establish this: "all 8 present" passes
            just as happily when a forbidden one is set and a wanted one is
            missing. Round R turns on DOSKUTSU_SHOT_TICKS being absent.

  --hw   what is PHYSICALLY FITTED, as an operator declaration. Written to
         <TAG>.HW beside the collected logs and labelled `declared`, because
         the harness cannot see its own slots. Defaults to the standing
         configuration (picogus,video,nic) -- pass it when that is not true,
         most importantly when the Vibra16S is back in for an audio test.

PER-CARD DEFAULTS, because a decision that has to be remembered gets forgotten.

  mach64  sets DOSKUTSU_PIN_NATIVE_MODE=0, which is REQUIRED on this card,
          not preferred. Without it the game runs at 512x384 -- outside the
          capture stick's 60 Hz range -- and the harness is blind for the
          whole cell: no mid-cell frame, no wedge diagnosis, no screenshot.
          512x384 was briefly kept as an opt-in for the ~3% it is faster;
          the operator withdrew that on 2026-08-19. This now REFUSES rather
          than warns, because leaving the variable unset IS 512x384 -- it is
          the card's own closest match to 320x240, so the blind mode is what
          you get by doing nothing.

  virge   NO pin change. The ViRGE picks 320x240 exactly, and standing the pin
          down would let a later mode-set take it to 640x480 -- changing the
          geometry every banked anchor was measured at. Safe on the Mach64
          precisely because nothing is banked there.

  cirrus  no pin change; it reaches a capturable mode unaided.
"""

import os
import re
import signal
import sys
import time
import importlib.util
from importlib.machinery import SourceFileLoader

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from vcctrl_common import (  # noqa: E402
    vc, at_prompt, wait_for_prompt, set_lock_owner, get_lock_owner)

_l = SourceFileLoader("sw", os.path.join(HERE, "vcctrl-sweep"))
_s = importlib.util.spec_from_loader("sw", _l)
_m = importlib.util.module_from_spec(_s)
sys.modules["sw"] = _m
_l.exec_module(_m)
grab = _m.grab

LOCK = "/tmp/vcctrl-machine.lock"


def acquire():
    """One driver at a time. Two at_prompt pollers toggle the same Caps Lock
    and read each other's toggles as their own answer."""
    if os.path.exists(LOCK):
        try:
            pid = int(open(LOCK).read().strip())
            os.kill(pid, 0)
            print("REFUSED: pid %d already holds the machine (%s)." % (pid, LOCK))
            print("  Two drivers polling at_prompt corrupt each other's reads.")
            return False
        except (ValueError, ProcessLookupError, PermissionError):
            pass          # stale lock
    open(LOCK, "w").write(str(os.getpid()))
    return True


def release():
    try:
        os.unlink(LOCK)
    except OSError:
        pass


def cmd(line, timeout=60):
    vc("type", line)
    vc("key", "enter")
    time.sleep(0.5)
    return wait_for_prompt(timeout) is not None


# OCR DOES NOT READ DIGITS RELIABLY IN THIS CONSOLE FONT.
#
# Measured on the target 2026-08-20: `count: 0` OCRs as `count: @`, every
# time. A `\d+` regex therefore never matches, the answer is scored
# COULD NOT READ, and the gate refuses a cell whose environment was in fact
# correct -- which is exactly what happened to R1A.
#
# The anchor word survives fine; only the glyph after it is unreliable. So
# the count is classified by CONFUSION CLASS rather than parsed as a number.
# `FIND /C` on a single variable name can only answer 0 or 1, so there are
# just two classes to separate and a wide margin between them.
#
# ANYTHING UNRECOGNISED STAYS None. A character that is in neither class is
# not guessed at -- it returns could-not-read and the caller refuses, which
# is the whole point of the three-state contract. Widening these sets to
# make a stubborn cell pass would be the same mistake as widening the
# brightness threshold to make the capture regression go away.
ZERO_LIKE = set("0OoQ@©")
ONE_LIKE = set("1lI|i!")


def read_count(text):
    """0, 1, or None for could-not-read. Never guesses."""
    if not text:
        return None
    m = re.search(r"COUNT\s*[:;.]?\s*(\S)", text.upper().replace(" ", " "))
    if not m:
        return None
    ch = m.group(1)
    if ch in ZERO_LIKE or ch.lower() in ZERO_LIKE:
        return 0
    if ch in ONE_LIKE or ch.lower() in ONE_LIKE:
        return 1
    return None


def read_env_text_raw():
    """OCR the current screen without issuing anything.

    Used by the per-variable re-check, which has already run its own filtered
    command and must not have `SET` typed over the top of it.
    """
    shot, _ = grab("cell-env-recheck")
    if shot is None:
        return None, None
    try:
        from PIL import Image
        import pytesseract
        return shot, pytesseract.image_to_string(Image.open(shot))
    except Exception:
        return shot, None


def read_env_text():
    """Read the machine's environment off the screen and return the raw OCR.

    This is the guard that would have caught the lost TAS_REPLAY. Capturing
    the screen was never the problem -- the screenshot existed and was never
    read. So it is parsed here, and a mismatch stops the run rather than
    relying on someone noticing.
    """
    cmd("SET")
    shot, _ = grab("cell-env")
    if shot is None:
        return None, None
    try:
        from PIL import Image
        import pytesseract
        return shot, pytesseract.image_to_string(Image.open(shot))
    except Exception:
        return shot, None


# WHAT IS FITTED, AS A DECLARATION -- NEVER AS A READING.
#
# vcctrl-cardid identifies the VIDEO card from the log, because the card's
# behaviour survives UniVBE's shim. Nothing equivalent exists for the rest of
# the slots: no artifact this harness produces says whether the Vibra16S was
# in the machine. The benchmarking session asked for this because the window
# during which the Vibra WAS fitted is currently bounded by prose in a chat
# log, which is not a provenance record.
#
# So this is the same class of statement as QAVID: what someone believes is
# fitted. It is written into the record as `hw_set=` and labelled `declared`,
# and it must never be presented as evidence. The interesting case is when it
# disagrees with cardid, and that case only exists if the two are kept
# distinguishable.
#
# Default is the standing configuration agreed 2026-08-19: the Vibra comes out
# unless something is actively testing it. Defaulting rather than requiring is
# deliberate -- a mandatory flag on every cell gets satisfied by habit, and a
# declaration made by reflex is worth less than a default someone can correct.
STANDING_HW = "picogus,video,nic"


def write_hw_record(tag, hw, card, incoming=None):
    """Drop <TAG>.HW next to the collected logs.

    A sidecar rather than a line in the LOG, because the LOG belongs to
    doskutsu and it does not dump the environment -- it logs only the hints it
    consults by name, so an invented DOSKUTSU_HW_SET would be set on the target
    and silently never appear anywhere. Checked against GP2.LOG before writing
    this rather than assumed.

    Machine-readable, one key per line, and every value tagged with how it was
    come by.
    """
    if incoming is None:
        incoming = os.path.expanduser("~/doskutsu-netiter/incoming")
    if not os.path.isdir(incoming):
        return None
    path = os.path.join(incoming, "%s.HW" % tag)
    body = [
        "tag=%s" % tag,
        "hw_set=%s" % hw,
        "hw_set_source=declared",
        "video_card_declared=%s" % (card or "unknown"),
        "video_card_attested=see vcctrl-cardid %sSDL.LOG" % tag,
        "note=hw_set is an operator declaration, not a probe. The harness",
        "note=cannot see which cards are fitted. Only the video card is",
        "note=independently attestable, and only from the SDL log.",
    ]
    with open(path, "w") as f:
        f.write("\n".join(body) + "\n")
    return path


LOCK_AS = "vcctrl-cell"


def take_lock(tag):
    """Hold the daemon's input lock for the duration of a cell.

    A cell is 150 s of the target's time plus a reboot either side and it is
    NOT resumable, so an interruption does not degrade one, it destroys it. A
    vcctrld restart landed inside a cell on 2026-08-19 and did exactly that.
    pi/deploy.sh refuses to run while this lock is held -- but only if somebody
    takes it, which is this function's entire reason to exist.

    Best-effort: a daemon too old to know the verb must not stop a cell, but it
    must say so, because "no lock" and "lock taken" are otherwise identical
    from the outside.
    """
    owner = "%s-%s" % (LOCK_AS, tag)
    try:
        vc("lock", "acquire", "--as", owner)
        # Present the same identity on every later input call, or the daemon
        # refuses OUR keystrokes too and the cell dies holding its own lock.
        set_lock_owner(owner)
        return True
    except Exception as exc:
        print("   NOTE: could not take the input lock (%s)." % exc)
        print("   The cell will run, but a deploy cannot see it and may kill it.")
        return False


def drop_lock():
    owner = get_lock_owner()
    try:
        if owner:
            vc("lock", "release", "--as", owner, check=False)
    except Exception:
        pass
    finally:
        set_lock_owner(None)


def main(argv):
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass
    if not argv or argv[0].startswith("-"):
        print(__doc__)
        return 2
    tag = argv[0].upper()
    sets, ticks, cfg, shot_at, card = [], "30000", "OPL3.CFG", 45, None
    forbid = []
    hw = STANDING_HW
    i = 1
    while i < len(argv):
        if argv[i] == "--card":
            card = argv[i + 1].lower(); i += 2
        elif argv[i] == "--hw":
            hw = argv[i + 1]; i += 2
        elif argv[i] == "--set":
            sets.append(argv[i + 1]); i += 2
        elif argv[i] == "--forbid":
            forbid.append(argv[i + 1]); i += 2
        elif argv[i] == "--ticks":
            ticks = argv[i + 1]; i += 2
        elif argv[i] == "--cfg":
            cfg = argv[i + 1]; i += 2
        elif argv[i] == "--shot-at":
            shot_at = int(argv[i + 1]); i += 2
        else:
            i += 1

    if not acquire():
        return 2
    try:
        print("== cell %s ==" % tag)
        rec = write_hw_record(tag, hw, card)
        print("   hw_set=%s (DECLARED, not probed%s)"
              % (hw, "" if rec else "; no incoming dir, not recorded"))
        if hw != STANDING_HW:
            print("   ** NOT the standing configuration (%s) **" % STANDING_HW)
        if rec:
            print("   recorded: %s" % rec)
        if take_lock(tag):
            print("   input lock held -- deploys refuse while this runs")
        if wait_for_prompt(60) is None:
            print("REFUSED: not at a prompt."); return 2
        if not cmd("CD \\DOSKUTSU"):
            print("REFUSED: could not reach C:\\DOSKUTSU"); return 2

        # Variables FIRST. If anything later prompts, it cannot eat a SET.
        wanted = {"DOSKUTSU_TAS_REPLAY": "QA.TAS",
                  "DOSKUTSU_TAS_PRNG_SEED": "12345",
                  "DOSKUTSU_TAS_AUTO_EXIT_TICK": ticks,
                  "DOSKUTSU_LOG_TAG": tag}
        if card == "mach64":
            wanted["DOSKUTSU_PIN_NATIVE_MODE"] = "0"
            print("   card=mach64 -> pin stood down, 640x480 (REQUIRED)")
        elif card in ("virge", "cirrus"):
            print("   card=%s -> pin left engaged (its own mode captures)" % card)
        elif card is None:
            print("REFUSED: no --card given. Per-card defaults exist because")
            print("  the right mode is not the same on every card, and on the")
            print("  Mach64 the wrong one is a blind cell. Pass --card.")
            return 2
        for s in sets:
            k, _, v = s.partition("=")
            wanted[k.upper()] = v

        # VARIABLES THAT MUST BE ABSENT.
        #
        # Round R turns on one: DOSKUTSU_SHOT_TICKS stalls the frame each dump
        # lands on, so a single stray dump turns a `perf` cell into `diag`
        # noise. The rule that decides the round is therefore an ABSENCE, and
        # until now this gate could not check one.
        #
        # THE COUNT GATE BELOW CANNOT VERIFY ABSENCE. It proves HOW MANY
        # variables are set, never WHICH. "all 8 variables present" passes
        # identically when SHOT_TICKS is set and something else is missing --
        # the totals match and the cell is silently the wrong class. That is
        # FINDINGS sec. 31, absence read as a value, sitting inside the gate
        # written to prevent it.
        #
        # So each forbidden name is asked about POSITIVELY, using the same
        # `FIND /C "="` primitive as the re-check: it answers 0 or 1, the
        # echoed question cannot manufacture a count line, and CLS means only
        # one count line can be on screen. An unreadable answer REFUSES --
        # could-not-look is not absence, and treating it as absence is exactly
        # how a two-valued check reports the instrument's state as the
        # target's.
        forbidden = [k.upper() for k in (forbid or [])]
        for k in forbidden:
            if k in wanted:
                print("REFUSED: %s is both required and forbidden." % k)
                return 2

        # OPERATOR DECISION 2026-08-19: on the Mach64, 640x480 is the ONLY
        # permitted mode. 512x384 was previously kept as an opt-in because it
        # is ~3% faster; that is withdrawn. The stick is 60 Hz-only firmware
        # and 512x384 is outside its range, so a cell in that mode is blind for
        # its whole duration -- no mid-cell frame, no wedge diagnosis, no
        # screenshot for the operator. Speed does not buy back observability.
        #
        # Enforced rather than documented, because "just leave the variable
        # unset" is what 512x384 looks like: it is the card's own preference
        # and reasserts itself the moment nobody is paying attention.
        if card == "mach64" and wanted.get("DOSKUTSU_PIN_NATIVE_MODE") != "0":
            print("   REFUSED: DOSKUTSU_PIN_NATIVE_MODE=%r would run this"
                  % wanted.get("DOSKUTSU_PIN_NATIVE_MODE"))
            print("   card at 512x384, which the capture stick cannot lock.")
            print("   640x480 is required on the Mach64. Remove the override.")
            return 2

        print("-- clearing and setting environment --")
        if not cmd("CALL CLRENV", 90):
            print("REFUSED: CLRENV did not finish."); return 2
        for k, v in wanted.items():
            if not cmd("SET %s=%s" % (k, v)):
                print("REFUSED: no prompt after SET %s" % k); return 2

        # THEN the copy, with its prompt answered explicitly. Plain `> NUL`
        # hides the copy's output, not its question.
        print("-- config, answering the overwrite prompt explicitly --")
        vc("type", "COPY CFGS\\%s DOSKUTSU.CFG" % cfg)
        vc("key", "enter")
        time.sleep(2.0)
        vc("key", "y")                 # answers the prompt if it appeared
        vc("key", "enter")             # harmless extra Enter if it did not
        if wait_for_prompt(60) is None:
            print("REFUSED: no prompt after COPY."); return 2

        print("-- verifying the environment actually took --")
        shot, text = read_env_text()
        print("   screenshot: %s" % shot)
        if text is None:
            # REFUSE, do not warn. This used to print a warning and launch
            # anyway, which is the worst of both: it produced a record that
            # READS like diligence -- "LOOK AT None BEFORE TRUSTING THIS RUN"
            # -- while committing the machine to a cell nobody had verified.
            # A gate that degrades to a printed warning exactly when it cannot
            # see is not a gate. GMQ3 launched that way; it survived only
            # because the ENGINE log records its own hints, which is a witness
            # this tool did not plan for.
            print("   REFUSED: could not read the environment back.")
            print("   screenshot=%r -- the capture is not showing the screen," % shot)
            print("   so the SET output cannot be verified. That is COULD NOT")
            print("   LOOK, which is not the same as verified-good, and a cell")
            print("   is too expensive to spend on an unchecked environment.")
            print("   Fix the capture (vcctrl pin off; vcctrl video state) and")
            print("   run again.")
            return 1
        else:
            # OCR on this console font is imperfect -- it reads CLRENV as
            # CLRENU and truncates long names -- so exact value matching would
            # cry wolf. Match on the variable NAME with a generous prefix,
            # which is enough to catch the real failure: a SET that never
            # happened produces no line at all.
            up = text.upper().replace(" ", "")
            missing = []
            for k in wanted:
                stem = k[:max(12, len(k) - 4)].replace("_", "")
                if stem.replace("_", "") not in up.replace("_", ""):
                    missing.append(k)
            # A BULK `SET` CAN SCROLL, AND A SCROLLED VARIABLE LOOKS ABSENT.
            #
            # This matters from MQ1 onward: seven SDL_HINT lines on top of the
            # six the tool already sets is thirteen, plus whatever the profile
            # carries. DOS prints the whole environment and the screen holds
            # about 25 lines, so an early variable can scroll off the top and
            # be reported NOT FOUND while being perfectly set.
            #
            # That failure is in the safe direction -- it refuses a good cell
            # rather than passing a bad one -- but refusing a good cell costs a
            # run and, worse, invites someone to disable the check. So each
            # miss is RE-CHECKED individually with a filtered SET, which prints
            # one line and cannot scroll. Absent after that is really absent.
            if missing:
                print("   %d not found in the bulk SET; re-checking each with"
                      " a filtered read, which cannot scroll" % len(missing))
                still = []
                for k in missing:
                    # ONE SHORT, UNAMBIGUOUS ANSWER, AND PROVE IT IS THIS
                    # COMMAND'S ANSWER.
                    #
                    # `FIND /C` prints a single `count: N` line. N is 1 or 0
                    # and the echoed question cannot produce a count line, so
                    # there is no way for the check to be satisfied by its own
                    # echo -- which the previous version could be.
                    #
                    # The screen is then polled until the OCR shows the echo
                    # of THIS variable's command, because a grab taken too
                    # soon returns the PREVIOUS command's screen. That is what
                    # made this refuse MQ1 three times on variables a
                    # photograph showed plainly set: the reading was real and
                    # was about the wrong moment (FINDINGS sec. 33, in my own
                    # instrument).
                    # CLS FIRST, so the screen can contain nothing but this
                    # command and its answer.
                    #
                    # The previous version proved "this is the right screen"
                    # by finding the variable's NAME in the OCR -- which fails
                    # whenever OCR misreads the name, and it misreads DKTCAP
                    # consistently in this console font. That is why DKTCAP
                    # failed in the bulk read AND the re-check, every run,
                    # while longer names recovered: the check depended on the
                    # one thing that was broken.
                    #
                    # After CLS there is only one count line it could belong
                    # to, so the answer needs no name matching at all.
                    stem2 = k[:max(12, len(k) - 4)].replace("_", "")
                    cmd("CLS")
                    time.sleep(1.0)
                    cmd('SET | FIND "%s" | FIND /C "="' % k)
                    # A GENEROUS BUDGET, because mode 12h text is SLOW.
                    #
                    # DKTCAP=1 keeps the console in mode 12h between cells and
                    # its own banner says "text will be SLOW". A full SET
                    # listing scrolls, and redrawing that takes many seconds --
                    # so the FIRST re-check after the bulk listing was polling
                    # a screen still being painted, while the second, by then
                    # settled, passed. That is why a different variable failed
                    # every run and why it was always the first one checked.
                    #
                    # 20 x 1.5 s = 30 s per variable, and only for variables
                    # the bulk read missed. Waiting is cheap; a refused cell
                    # is not.
                    verdict = None
                    for _try in range(20):
                        time.sleep(1.5)
                        _sh, t2 = read_env_text_raw()
                        if t2 is None:
                            continue
                        up = t2.upper()
                        m = re.search(r"COUNT[:\s]+(\d+)", up)
                        if m:
                            verdict = int(m.group(1))
                            break
                    if verdict is None:
                        print("     %-32s COULD NOT READ -- not the same as absent"
                              % k)
                        still.append(k)
                    elif verdict > 0:
                        print("     %-32s found on re-check (had scrolled)" % k)
                    else:
                        still.append(k)
                missing = still

            for k in sorted(wanted):
                print("     %-32s %s" % (k, "ok" if k not in missing else "NOT FOUND"))

            # The specific signature of the bug that cost a cell: a copy
            # overwrite prompt sitting in the transcript means it ate whatever
            # was typed next.
            # An overwrite prompt in the transcript is NOT by itself a fault.
            # This tool answers that prompt on purpose, so the text it looks
            # for is text it produces itself -- as written, the check refused
            # its own correct behaviour and failed cell M64A with all five
            # variables verifiably set.
            #
            # The discriminator is one line further down. DOS prints "1 file(s)
            # copied" only after the question has been answered; an unanswered
            # prompt is still sitting there with nothing under it. So the fault
            # is the prompt WITHOUT a completion, not the prompt.
            prompt_seen = ("YES/NO/AL" in up or "OVERWRIT" in up
                           or "QUERURIT" in up)
            copy_done = "FILE(S)COPIED" in up or "FILES)COPIED" in up
            if prompt_seen and not copy_done:
                print("   *** AN UNANSWERED OVERWRITE PROMPT IS ON SCREEN ***")
                print("   No completion line under it. It consumes the next")
                print("   character typed, so whatever command followed it was")
                print("   truncated. Do not trust this cell.")
                return 1
            if prompt_seen:
                print("   overwrite prompt answered, copy completed")
            if missing:
                print("   REFUSED: %d variable(s) not found in the environment."
                      % len(missing))
                print("   This is the failure that cost a cell on 2026-08-19 --")
                print("   a prompt ate the SET and the prompt still came back.")
                return 1
            print("   all %d variables present" % len(wanted))

            if forbidden:
                print("   -- and %d that must be ABSENT --" % len(forbidden))
                # ASKED POSITIVELY, WITH NO VARIABLE EXPANSION ANYWHERE.
                #
                # The obvious design -- and the one a peer proposed -- is to
                # have DOS itself assert the state:
                #     IF "%VAR%"=="" ECHO ABSENT
                #     IF NOT "%VAR%"=="" ECHO PRESENT
                # so that both states emit a token and silence is a third
                # outcome. It is a good shape and it DOES NOT WORK HERE.
                # MS-DOS 6.22 expands %VAR% in BATCH FILES, not at the
                # interactive prompt. Measured on the target 2026-08-20:
                #     IF "%ZZNOSUCHVAR%"=="" ECHO EXPANSION_WORKS   -> nothing
                #     ECHO [%VCQ%]                                  -> [%VCQ%]
                # The literal `"%VAR%"` never equals `""`, so `IF NOT` fires
                # unconditionally and every variable reads PRESENT forever.
                # It fails closed rather than open, so it would have refused
                # all eight cells instead of passing a bad one -- but a gate
                # that always refuses is not a gate either.
                #
                # `SET | FIND "NAME" | FIND /C "="` needs no expansion at all:
                # it is pure text processing, which is why it has worked every
                # run. Measured the same evening:
                #     ZZPROBE set     -> count: 1
                #     SHOT_TICKS unset-> count: 0
                # The echoed question contains no `count:` line, so the check
                # cannot be satisfied by its own echo, and a screen that never
                # produces one is a THIRD outcome -- refused, not read as
                # absence.
                bad, unreadable = [], []
                for k in forbidden:
                    cmd("CLS")
                    time.sleep(1.0)
                    cmd('SET | FIND "%s" | FIND /C "="' % k)
                    verdict = None
                    for _try in range(20):
                        time.sleep(1.5)
                        _sh, t3 = read_env_text_raw()
                        if t3 is None:
                            continue
                        verdict = read_count(t3)
                        if verdict is not None:
                            break
                    if verdict is None:
                        print("     %-32s COULD NOT READ -- NOT the same as absent" % k)
                        unreadable.append(k)
                    elif verdict > 0:
                        print("     %-32s *** SET, AND MUST NOT BE ***" % k)
                        bad.append(k)
                    else:
                        print("     %-32s absent (count 0, read back)" % k)
                if bad:
                    print("   REFUSED: %d forbidden variable(s) are set: %s"
                          % (len(bad), " ".join(bad)))
                    print("   This cell would be measuring something other than")
                    print("   what it claims. CLRENV should have cleared it.")
                    return 1
                if unreadable:
                    print("   REFUSED: could not read %d forbidden variable(s)"
                          " back: %s" % (len(unreadable), " ".join(unreadable)))
                    print("   An unreadable answer is COULD NOT LOOK, not")
                    print("   absence. Passing here would launch a cell whose")
                    print("   validity rule was never actually checked.")
                    return 2

            # PROFILE WITNESS: BLASTER MUST BE SET.
            #
            # A cell inherits whatever boot profile the machine happens to be
            # sitting in, and NOTHING in this tool has ever checked which one.
            # R1A died on 2026-08-20 because the machine was still in the NET
            # profile from a hand-run FTP transfer forty minutes earlier --
            #     [critical] ack, sdl_init failed: No BLASTER environment
            #     variable to find Sound Blaster.
            # -- and it wrote a 1,102-byte log instead of ~120,000.
            #
            # THE TWO PROFILES LOOK IDENTICAL FROM HERE. Same `C:\DOSKUTSU>`
            # prompt, same screen, same at_prompt, same everything this
            # harness can see. `vcctrl-collect` even warns "DO NOT start a
            # measured run without rebooting it first" when it leaves the
            # machine in NET -- but the warning is printed to a log nobody
            # reads at the moment it matters, and an ad-hoc FTP session
            # bypasses it entirely.
            #
            # BLASTER is set by the default profile's AUTOEXEC and is absent
            # in NET, so it is a witness to the whole boot path rather than a
            # declaration about it. Checked with the same count primitive, and
            # unreadable REFUSES.
            print("   -- profile witness --")
            cmd("CLS")
            time.sleep(1.0)
            cmd('SET | FIND "BLASTER" | FIND /C "="')
            wv = None
            for _try in range(20):
                time.sleep(1.5)
                _sh, t4 = read_env_text_raw()
                if t4 is None:
                    continue
                wv = read_count(t4)
                if wv is not None:
                    break
            if wv is None:
                print("     BLASTER                          COULD NOT READ")
                print("   REFUSED: could not establish which boot profile is")
                print("   running. That is COULD NOT LOOK, not a pass.")
                return 2
            if wv == 0:
                print("     BLASTER                          *** NOT SET ***")
                print("   REFUSED: the machine is not on the sound profile.")
                print("   Almost certainly still in NET from a collect or a")
                print("   hand-run FTP session. sdl_init will fail and the cell")
                print("   will die in seconds. Reboot to the menu default")
                print("   (ctrl-alt-del, let the 5s timeout land on PGSB).")
                return 1
            print("     BLASTER                          set (profile is PGSB)")

        print("-- launch --")
        t0 = time.time()
        vc("type", "DOSKUTSU.EXE")
        vc("key", "enter")
        time.sleep(12)
        if at_prompt():
            print("   *** CELL DID NOT START -- prompt 12s after launch ***")
            s2, _ = grab("cell-%s-failed" % tag)
            print("   screen: %s" % s2)
            return 1
        print("   confirmed running")

        time.sleep(max(0, shot_at - (time.time() - t0)))
        shot, mean = grab("cell-%s" % tag)
        print("   mid-cell capture: %s (brightness %s)"
              % (shot, "%.1f" % mean if mean is not None else "NO LOCK"))

        w = wait_for_prompt(400)
        if w is None:
            print("   NO PROMPT after %.0fs -- cell may be stuck." % (time.time() - t0))
            return 1
        print("== done in %.0fs ==" % (time.time() - t0))
        return 0
    finally:
        # The game leaves the display in a mode the capture stick cannot lock,
        # so every cell ends blind unless the console mode is put back. Observed
        # 2026-08-19: a post-cell read of the log returned "no picture" six
        # times in a row against a perfectly healthy machine, because the mode
        # was never restored. Do this BEFORE releasing anything, and do it even
        # on the failure paths -- a cell that died is exactly when someone needs
        # to see the screen.
        try:
            vc("type", "C:\\VGACAP\\MODE12", check=False)
            vc("key", "enter", check=False)
            time.sleep(3)
        except Exception:
            pass
        drop_lock()
        release()


def _bail(signum, _frame):
    """Drop BOTH locks on a signal, then die.

    GMQ3 was SIGTERMed when the shell that launched it hit a timeout, and
    SIGTERM's default action does not run `finally` -- so the daemon input
    lock was left held by a process that no longer existed, and recovering it
    needed `lock break`, which marks the run tainted.

    The file lock was already released here; the DAEMON lock was not, and it
    is the one that stops everyone else from typing.
    """
    try:
        drop_lock()
    except Exception:
        pass
    try:
        release()
    except Exception:
        pass
    sys.stderr.write("\nsignal %d -- released both locks, target left as it "
                     "was\n" % signum)
    os._exit(128 + signum)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _bail)
    signal.signal(signal.SIGHUP, _bail)
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        _bail(signal.SIGINT, None)
