#!/usr/bin/env python3
"""vcctrl-collect -- bring a sweep's logs back off the g2k, unattended.

Runs on the VM, after a sweep has finished and the machine is sitting at a
prompt. Reboots into the NET profile, runs PUT for each of the sweep's cell
tags, and confirms each file by watching the FTP server's incoming directory.

Two design choices worth knowing before changing anything here.

REBOOT RATHER THAN LOAD-AT-PROMPT.  The obvious cheaper route is to load the
ODI stack from the prompt the sweep left us at, skipping the reboot entirely.
That is NOT done, for two reasons. The stack has no proven prompt-load path --
LSL/E100BODI/ODIPKT are designed to load from AUTOEXEC and stay, and nothing
has ever verified they initialise correctly against a machine whose sound TSRs
are already resident. And it has no unload path at all, so a machine that had
the stack loaded by hand could not be returned to a measurement-clean state
without the reboot we were trying to avoid. Ctrl-Alt-Del costs about 43 s.
That is cheap enough that guessing is not worth it.

CONFIRMATION COMES FROM THE FILESYSTEM, NOT THE SCREEN.  PUT prints a success
line, and the console is in mode 12h so that line is capturable -- but reading
it would mean OCR, and an OCR misread would silently mark a missing log as
collected. The FTP server runs on this host, so the arrival of the file in
incoming/ is directly observable. That single check also proves everything
upstream of it: the reboot took, the NET profile was selected, the ODI stack
loaded, the packet driver answered, and the log existed to be sent. Nothing
else needs verifying because nothing else can be true if the file is there.

Usage:
  vcctrl-collect <SWEEP> <machine-digit> [options]
  vcctrl-collect --tags GMN,GMF          [options]

  --power-on        bring the target up if it is off, instead of refusing
  --already-net     skip the reboot; the machine is already in NET
  --stay-net        leave it in NET afterwards (default: reboot to the
                    menu default, which is measurement-clean)
  --incoming <dir>  FTP landing directory
                    (default ~/doskutsu-netiter/incoming)
"""

import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from vcctrl_common import (  # noqa: E402
    vc, vc_json, leds, wait_led, at_prompt, wait_for_prompt, arm_leds,
    ensure_powered)

CONF = os.path.join(os.path.dirname(HERE), "sweep", "sweeps.json")
DEFAULT_INCOMING = os.path.expanduser("~/doskutsu-netiter/incoming")

# NET is menu item 5. The digit alone does not commit the selection -- it only
# highlights -- so every attempt is digit-then-Enter. See FINDINGS sec. 8.
NET_MENU_ITEM = "5"

# EVERY vcctrl CALL COSTS ABOUT 1.5 s. It is an ssh round-trip to the Pi, and
# that dominates everything here -- measured 1.52-2.55 s per call, against a
# PS/2 LED round-trip that is comfortably under one poll interval. Any timing
# in this file has to be reasoned about in calls, not in sleeps. A loop that
# "polls every 0.5 s" while calling leds() actually paces at about 2 s.
CALL_COST_S = 1.5

# The CONFIG.SYS menu is invisible to the capture stick -- it runs in text mode
# 03h, before AUTOEXEC sets mode 12h -- and TIMES OUT IN 5 SECONDS. So the
# selection is blind and the cadence has to beat that 5 s window.
#
# Which is why nothing polls the LEDs while the menu might be up. An earlier
# version interleaved a leds() read with each attempt, which put two ssh calls
# between attempts and paced the digit at roughly 5 s -- the exact width of the
# window it was trying to hit. It would have worked sometimes. Instead: blanket
# the whole window with digit+Enter as a SINGLE call, then start looking.
#
# Extra "5<Enter>" pairs landing at a live prompt are harmless; DOS answers
# "Bad command or file name" and carries on.
# Bounded two ways on purpose. The window alone was not enough: budgeted at
# 40 s it ran 71 s, because vcctrl calls block far longer during POST than the
# 1.76 s they take at idle. Every overrun keystroke lands in the BIOS buffer,
# which fills at 15 and then beeps once per rejection -- audible from the next
# room -- and the survivors flush into the prompt as "Bad command or file
# name". Measured shape of a reboot: caps-clear edge, then RDYPULSE about 12 s
# later, with the 5 s menu somewhere inside that. 20 s of cover is generous.
MENU_SPAM_WINDOW_S = 20
MENU_SPAM_MAX_ATTEMPTS = 12
REBOOT_EDGE_TIMEOUT_S = 45      # measured at t+9 s; this is deliberate slack
READY_TIMEOUT_S = 150           # measured ~11 s post-POST, POST itself varies
PUT_TIMEOUT_S = 90              # 880 KB/s measured; a log pair is under 400 KB


def reboot_into_net():
    print("== reboot into NET ==")
    if not arm_leds():
        raise SystemExit("REFUSED: could not arm the LEDs. Without a known "
                         "starting state\n  neither the reboot edge nor the "
                         "readiness pulse can be trusted.")
    print("  LEDs armed: caps=1 (reboot edge), scroll=0 (readiness pulse)")

    vc("combo", "ctrl", "alt", "delete")
    edge = wait_led("capslock", False, REBOOT_EDGE_TIMEOUT_S)
    if edge is None:
        raise SystemExit("REFUSED: no reboot edge within %ds. Ctrl-Alt-Del only "
                         "works at a\n  prompt, never in-game -- SDL3's DOS "
                         "backend owns INT 09h. If a cell is\n  still running, "
                         "this is the expected failure and the machine is fine."
                         % REBOOT_EDGE_TIMEOUT_S)
    print("  reboot edge at t+%.1fs" % edge)

    print("  blanketing the menu window with '%s'+Enter (max %ds / %d attempts)"
          % (NET_MENU_ITEM, MENU_SPAM_WINDOW_S, MENU_SPAM_MAX_ATTEMPTS))
    t0 = time.time()
    attempts = 0
    while (time.time() - t0 < MENU_SPAM_WINDOW_S
           and attempts < MENU_SPAM_MAX_ATTEMPTS):
        # One call, not two: the client taps a sequence, so this is ~1.5 s
        # rather than ~3 s, which is what keeps the cadence inside the menu's
        # 5 s. Nothing polls the LEDs in here -- a poll is another 1.5 s and
        # would push the cadence back out past the window it has to hit.
        vc("key", NET_MENU_ITEM, "enter", check=False)
        attempts += 1
    print("  %d attempts over %.1fs (%.1fs apart)"
          % (attempts, time.time() - t0, (time.time() - t0) / max(attempts, 1)))

    t1 = time.time()
    if wait_led("scrolllock", True, READY_TIMEOUT_S) is None:
        raise SystemExit(
            "REFUSED: no RDYPULSE within %ds of the reboot edge.\n"
            "  Either the machine did not reach a prompt, or C:\\DRIVERS\\RDYPULSE.COM\n"
            "  is missing -- both AUTOEXEC call sites are IF EXIST guarded, so a\n"
            "  deleted COM looks exactly like a hang from here. Check with capture\n"
            "  before power-cycling." % READY_TIMEOUT_S)
    print("  RDYPULSE at t+%.1fs -- AUTOEXEC complete" % (time.time() - t1))

    # RDYPULSE means AUTOEXEC FINISHED, not that COMMAND.COM is reading input.
    # There is a short tail -- the last AUTOEXEC lines, the return to the
    # shell -- and probing inside it gets a false negative, because the
    # keystroke buffers rather than being processed. This used to be
    # time.sleep(SETTLE_S), which is the same guess-an-interval mistake as
    # bugs 2 and 4; wait for the prompt instead of assuming a duration.
    waited = wait_for_prompt(60)
    if waited is None:
        raise SystemExit("REFUSED: RDYPULSE fired but no prompt within 60s.")
    print("  prompt live %.1fs later" % waited)
    return True


def snapshot(incoming):
    """Record what is already in incoming/, so a stale file from a previous
    run cannot be mistaken for a fresh arrival."""
    out = {}
    for n in os.listdir(incoming):
        p = os.path.join(incoming, n)
        try:
            st = os.stat(p)
            out[n] = (st.st_mtime, st.st_size)
        except OSError:
            pass
    return out


def arrived(incoming, name, before):
    p = os.path.join(incoming, name)
    if not os.path.exists(p):
        return False
    st = os.stat(p)
    return before.get(name) != (st.st_mtime, st.st_size)


def put_tag(incoming, tag, before):
    """Run PUT for one tag and wait for its log pair to land."""
    want = ["%s.LOG" % tag, "%sSDL.LOG" % tag]
    # C:\MTCP is not in PATH -- see the g2k README. Full path, not a CD, so the
    # working directory the sweep left us in does not matter.
    vc("type", "C:\\MTCP\\PUT.BAT %s" % tag)
    vc("key", "enter")

    t0 = time.time()
    got = set()
    while time.time() - t0 < PUT_TIMEOUT_S:
        for n in want:
            if n not in got and arrived(incoming, n, before):
                got.add(n)
                print("      %-16s %8d bytes  t+%.1fs"
                      % (n, os.path.getsize(os.path.join(incoming, n)),
                         time.time() - t0))
        if len(got) == len(want):
            return True, got
        time.sleep(2.0)
    return False, got


def put_manifest(incoming, name, src, before, label):
    """Upload one non-log file (a sweep manifest, BINARY.NFO) via CHK.BAT.

    PUT.BAT sends the LOG pair and nothing else, which is why the first RB run
    came back with no `config=` line anywhere: RB.BAT writes the witness to
    LOGS\\<tag><SWEEP>.NFO, and that file simply never left the card. The boot
    profile was then attested only by the operator's recollection of which menu
    entry they picked -- which is the exact dependency r16 added the witness to
    remove. A provenance record that stays on the machine is not a provenance
    record.

    There is ONE manifest per sweep run, not one per cell.
    """
    print("  %s %s" % (label, name))
    vc("type", "C:\\DOSKUTSU\\CHK.BAT %s %s" % (src, name))
    vc("key", "enter")
    t0 = time.time()
    while time.time() - t0 < PUT_TIMEOUT_S:
        if arrived(incoming, name, before):
            print("      %-16s %8d bytes  t+%.1fs"
                  % (name, os.path.getsize(os.path.join(incoming, name)),
                     time.time() - t0))
            return True
        time.sleep(2.0)
    print("      not returned within %ds" % PUT_TIMEOUT_S)
    return False


def main(argv):
    # Line-buffer stdout. These are long jobs that are usually run in the
    # background, and Python block-buffers to a pipe -- which meant a 23-minute
    # sweep reported absolutely nothing until it exited. Progress you cannot
    # see during the run is not progress you can supervise.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0

    incoming = DEFAULT_INCOMING
    if "--incoming" in argv:
        incoming = argv[argv.index("--incoming") + 1]
    already_net = "--already-net" in argv
    allow_power_on = "--power-on" in argv
    stay_net = "--stay-net" in argv

    if argv[0] == "--tags":
        tags = [t.strip().upper() for t in argv[1].split(",") if t.strip()]
        label = "ad-hoc"
        manifest = None          # no sweep name, so no manifest to name
    else:
        if len(argv) < 2:
            print(__doc__)
            return 2
        sweep, machine = argv[0].upper(), argv[1]
        with open(CONF) as f:
            conf = json.load(f)
        if sweep not in conf["sweeps"]:
            raise SystemExit("REFUSED: unknown sweep %s" % sweep)
        if machine not in conf["machines"]:
            raise SystemExit("REFUSED: unknown machine digit %r" % machine)
        spec = conf["sweeps"][sweep]
        if "tags" not in spec:
            raise SystemExit("REFUSED: %s has no tags in sweeps.json, so there "
                             "is nothing\n  defensible to ask for. See "
                             "_tags_comment for how to derive them." % sweep)
        mtag = conf["machines"][machine]["tag"]
        tags = [mtag + t for t in spec["tags"]]
        manifest = "%s%s.NFO" % (mtag, sweep)
        label = "%s on machine %s (%s)" % (sweep, mtag,
                                           conf["machines"][machine]["name"])

    print("== collect: %s ==" % label)
    print("  tags: %s" % " ".join(tags))
    if manifest:
        print("  manifest: %s (carries config= -- the boot-profile witness)" % manifest)

    if not os.path.isdir(incoming):
        raise SystemExit("REFUSED: incoming directory %s does not exist." % incoming)
    print("  incoming: %s" % incoming)

    if not ensure_powered(allow_power_on):
        return 2

    if not already_net:
        if not at_prompt():
            raise SystemExit("REFUSED: target did not answer the LED probe. It is "
                             "not at a\n  prompt, or something is still running. "
                             "Not rebooting that.")
        print("  target is at a prompt: ok")
        reboot_into_net()
    else:
        print("  --already-net: assuming the NET profile is booted")
        if not at_prompt():
            raise SystemExit("REFUSED: target did not answer the LED probe.")

    before = snapshot(incoming)

    print("\n== transfer ==")
    ok, failed = [], []
    for tag in tags:
        print("  PUT %s" % tag)
        good, got = put_tag(incoming, tag, before)
        if good:
            ok.append(tag)
        else:
            failed.append(tag)
            missing = [n for n in ("%s.LOG" % tag, "%sSDL.LOG" % tag) if n not in got]
            print("      TIMEOUT after %ds -- missing %s"
                  % (PUT_TIMEOUT_S, ", ".join(missing)))
        before = snapshot(incoming)

    # The manifest carries config=%config%, which is the only artifact that
    # proves which boot profile produced these logs. Pull it in the same NET
    # session -- a second trip costs another reboot.
    if manifest:
        print("\n== provenance ==")
        if not put_manifest(incoming, manifest,
                            "C:\\DOSKUTSU\\LOGS\\" + manifest, before,
                            "manifest"):
            failed.append(manifest)
        before = snapshot(incoming)
        # BINARY.NFO describes what is actually installed on the card. The
        # engine logs binary_sha12=UNKNOWN, so this is the only record of
        # binary identity that travels with a run.
        put_manifest(incoming, "BINARY.NFO", "C:\\DOSKUTSU\\BINARY.NFO",
                     before, "binary  ")
        before = snapshot(incoming)

    if not stay_net:
        print("\n== return to the menu default ==")
        # The last PUT confirmed its file ARRIVED, which happened while DOS was
        # still inside FTP.EXE. Wait for the prompt to come back before typing
        # at it, or the keystrokes buffer and arming times out on a machine
        # that is perfectly healthy -- and the machine is then left in NET.
        waited = wait_for_prompt(90)
        if waited is None:
            print("  WARNING: no prompt within 90s; leaving the machine in NET.")
            print("  DO NOT start a measured run without rebooting it first.")
        else:
            print("  prompt back after %.1fs" % waited)
        # No digit: the 5 s menu timeout lands on PGSB, which is
        # measurement-clean. Leaving the machine in NET would mean the next
        # sweep ran with the packet driver resident.
        if arm_leds():
            vc("combo", "ctrl", "alt", "delete")
            if wait_led("capslock", False, REBOOT_EDGE_TIMEOUT_S) is None:
                print("  WARNING: no reboot edge; machine may still be in NET.")
            elif wait_led("scrolllock", True, READY_TIMEOUT_S) is None:
                print("  WARNING: no RDYPULSE; machine may not have reached a prompt.")
            elif wait_for_prompt(60) is None:
                print("  WARNING: RDYPULSE fired but no prompt within 60s.")
            else:
                print("  back at a prompt on the default profile.")
        else:
            print("  WARNING: could not arm LEDs; skipped the return reboot.")

    print("\n== result ==")
    print("  collected: %s" % (" ".join(ok) if ok else "(none)"))
    if failed:
        print("  MISSING:   %s" % " ".join(failed))
        print("""
  If EVERY tag failed, suspect the blind menu selection rather than the logs:
  a missed selection boots the 5 s default instead of NET, which reaches a
  perfectly healthy prompt with no packet driver, and PUT then fails on all of
  them identically. Capture the screen and look for "[NET] ready." before
  chasing anything else.

  A missing log is a real signal, not necessarily a transfer fault. The
  likeliest cause is that the cell never wrote one -- it died at sdl_init, or
  the sweep stopped early. Look for the tag under C:\\DOSKUTSU\\LOGS on the
  card before assuming the network was at fault; PUT cannot send a file that
  is not there, and it fails quietly when asked to.""")
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        # Line-buffered output means `| head` closes the pipe under us. That is
        # the reader's choice, not an error worth a traceback.
        os._exit(0)
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted -- the target is left as it was\n")
        os._exit(130)
