#!/usr/bin/env python3
"""vcctrl-uvconfig -- run UniVBE's uvconfig after a video card swap, closed-loop.

WHAT UVCONFIG ACTUALLY DOES, measured on the ViRGE 2026-08-19 rather than
assumed: with the card unchanged it runs **silently and non-interactively**,
rewrites C:\\UNIVBE\\UNIVBE.DRV and UVCONFIG.DAT in a couple of seconds, and
returns straight to the prompt. No screens, no keypresses.

The operator's remembered workflow -- "run uvconfig, press space, press space
again (I think)" -- did not reproduce. I first guessed those prompts appear
only when the DETECTED card differs from the stored config. **That guess was
then tested and is wrong:** the ViRGE was swapped for a Mach64 and uvconfig
ran just as silently. So the prompts come from something else entirely -- a
different UniVBE version, a different entry point (UNICENTR.EXE is also on the
card), or an invocation with arguments. Unknown, and recorded as unknown.

Which is exactly why this sends no keys. The condition that triggers the
interactive path has now survived two attempts to characterise it, so any
fixed key sequence is being written against a screen nobody has seen.

So this tool does NOT send a key sequence. It runs uvconfig, then looks:

  * back at a DOS prompt  -> done, nothing was asked
  * anything else on screen -> STOP and surface the frame

Refusing the unknown path is the whole point. A fixed "space, space" would
work on the silent path by doing nothing visible and would press blindly into
whatever a swap actually shows -- and UniVBE's config screens include mode
tables where a wrong keypress selects a different refresh rate. Being wrong
here is not a crash; it is a machine that boots fine and drives the monitor
slightly wrong, which is the kind of wrong that gets measured.

uvconfig GENERATES a driver; UNIVBE.EXE loads it at TSR-load time from
AUTOEXEC. A resident TSR keeps the driver it started with, so a reboot is
required for the new config to take effect. This does that too, and confirms
the prompt afterwards.

Usage:
  vcctrl-uvconfig [--no-backup] [--no-reboot]
"""

import os
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from vcctrl_common import (  # noqa: E402
    vc, at_prompt, wait_for_prompt, arm_leds, wait_led)

sys.path.insert(0, HERE)


def grab(tag):
    """Capture a frame. Imported lazily from the sweep runner to avoid
    duplicating the settle-frame logic a third time."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    # Same documented crossing as vcctrl_common.grab(): the sweep runner is in
    # harness/ now, and uvconfig borrows its settle-frame logic rather than
    # keeping a third copy. docs/CONFIG-PLAN.md sec. 6.
    _harness = os.path.join(os.path.dirname(HERE), "harness")
    loader = SourceFileLoader("sweepmod", os.path.join(_harness, "vcctrl-sweep"))
    spec = importlib.util.spec_from_loader("sweepmod", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules["sweepmod"] = mod
    loader.exec_module(mod)
    return mod.grab(tag)


def dos(line, settle=2.0):
    vc("type", line)
    vc("key", "enter")
    time.sleep(settle)


def main(argv):
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass

    if "--verify" in argv:
        return verify()
    backup = "--no-backup" not in argv
    reboot = "--no-reboot" not in argv

    print("== preflight ==")
    # Wait rather than ask once -- a single negative probe usually means the
    # keystroke buffered, not that the machine is unusable. See FINDINGS bug 6.
    if wait_for_prompt(45) is None:
        print("REFUSED: no prompt within 45s.")
        return 2
    print("  at a prompt: ok")

    shot, mean = grab("uv-before")
    if shot is None:
        print("REFUSED: capture is not locked. Every check below is read off")
        print("  the screen, so running blind here would prove nothing.")
        return 2
    print("  capture locked (brightness %.1f)" % mean)

    # ------------------------------------------------------------------
    # REFUSE. This tool cannot do this job, and on 2026-08-19 it proved it by
    # leaving the rig broken for six hours.
    #
    # UVCONFIG.EXE is an interactive full-screen configurator. It writes
    # UNIVBE.DRV and UVCONFIG.DAT AS IT RUNS, so by the time anything can
    # decide whether to continue, the files are already changed. The earlier
    # version backed up, launched it, and then used at_prompt() to decide
    # whether it had finished -- but at_prompt() is a BIOS-level Caps Lock
    # probe that returns True while a program is running and reading nothing
    # (FINDINGS sec. 20). So it reported "uvconfig completed without asking
    # anything", rebooted, and left a half-written mode table advertising
    # 320x240 on a Mach64-CT, which cannot double-scan and has no such mode.
    # The game then picked that mode as closest-match to its own 320x240 and
    # rendered nothing at all. Every "engine defect" diagnosed downstream was
    # the engine faithfully using a mode table that was a lie.
    #
    # AND IT CANNOT BE FIXED BY BEING BRAVER. The configurator writes to the
    # text buffer at 0xB800. In mode 12h -- the graphics mode the capture stick
    # needs -- those writes land in memory that is not displayed, so the menu is
    # invisible to the harness AND to anyone at the monitor. In text mode 03h it
    # is visible on the monitor but the stick cannot lock 70Hz. There is no mode
    # in which the harness and the configurator can both see the screen.
    #
    # So: prepare and verify, never perform. The rule this encodes is the one
    # that would have saved the six hours -- REFUSE TO WRITE ANYTHING UNLESS
    # THE WHOLE PROCEDURE CAN COMPLETE. A machine left neither configured nor
    # untouched is worse than one left alone.
    print("\n== REFUSED: this tool cannot run UVCONFIG, and will not start it ==")
    print()
    print("  UVCONFIG.EXE is interactive and writes its config as it runs, so")
    print("  a tool that cannot finish it must not begin it. It is also")
    print("  invisible in mode 12h, which is the mode capture requires -- so")
    print("  neither this harness nor a person at the monitor can read its")
    print("  menus while the machine is capturable.")
    print()
    print("  RUN IT AT THE MACHINE. The procedure, in full:")
    print()
    print("    C:\\VGACAP\\MODE03          (text mode -- capture goes blind)")
    print("    C:\\UNIVBE\\UVCONFIG.EXE    (detect the card, save, exit)")
    print("    C:\\VGACAP\\MODE12          (restore capture)")
    print("    Ctrl-Alt-Del                (AUTOEXEC loads the new config)")
    print()
    print("  Read what it prints. It names the chip it detected and any modes")
    print("  it is withholding -- on the Mach64-CT it reports that 320x200 and")
    print("  320x240 are unavailable because the board cannot double-scan, and")
    print("  that line is the difference between a working rig and six hours.")
    print()
    print("  Then run:  vcctrl-uvconfig --verify")
    print("  which reads the resulting configuration back out of a cell log")
    print("  and says whether it took.")
    return 2


def verify():
    """Check what configuration actually loaded, from a cell's own log.

    Reads the machine rather than the files on disk: a mode list is what the
    running system OFFERS, which is the thing that matters and the thing that
    was wrong. File sizes and timestamps looked correct throughout the incident.
    """
    print("== verify: reading the loaded configuration ==")
    print()
    print("  Run a cell first, then check its SDL log on the target:")
    print()
    print('    FIND /I "oem_string"  C:\\DOSKUTSU\\LOGS\\<TAG>SDL.LOG')
    print('    FIND /I "0x01F8"      C:\\DOSKUTSU\\LOGS\\<TAG>SDL.LOG')
    print('    FIND /I "MODESET: id=" C:\\DOSKUTSU\\LOGS\\<TAG>SDL.LOG')
    print('    FIND /I "LFB-decision" C:\\DOSKUTSU\\LOGS\\<TAG>SDL.LOG')
    print('    FIND /I "FB-INIT"     C:\\DOSKUTSU\\LOGS\\<TAG>SDL.LOG')
    print()
    print("  A correctly configured Mach64-CT shows:")
    print("    oem_string='Universal VESA VBE 6.70'")
    print("    0x01F8            no matches   (320x240 needs double scanning)")
    print("    LFB-decision      use_lfb=1    (taken unaided; no FORCE_LFB)")
    print()
    print("  total_vram identifies the CARD through the shim -- 2048 KB on the")
    print("  Mach64, 4096 on the ViRGE -- while the mode table only reflects the")
    print("  driver. They sit two lines apart and attest different layers.")
    return 0

    if not reboot:
        print("\n  --no-reboot: the new UNIVBE.DRV is on disk but NOT in effect.")
        print("  The resident TSR is still running the previous driver.")
        return 0

    print("\n== reboot (the new driver only loads at TSR-load time) ==")
    if not arm_leds():
        print("  WARNING: could not arm LEDs; not rebooting blind.")
        return 1
    vc("combo", "ctrl", "alt", "delete")
    edge = wait_led("capslock", False, 60)
    if edge is None:
        print("  REFUSED: no reboot edge.")
        return 1
    print("  reboot edge at t+%.1fs" % edge)
    if wait_led("scrolllock", True, 200) is None:
        print("  REFUSED: no RDYPULSE.")
        return 1
    waited = wait_for_prompt(90)
    if waited is None:
        print("  REFUSED: RDYPULSE fired but no prompt.")
        return 1
    print("  prompt live")

    shot, mean = grab("uv-post-reboot")
    if shot is None:
        print("  NO SIGNAL after reboot -- the new driver may have changed the")
        print("  video timing beyond what the capture stick locks. Check the")
        print("  monitor; roll back with the .BAK copies if needed.")
        return 1
    print("  capture still locked (brightness %.1f)" % mean)
    print("\n== done ==")
    print("  Next: run a sweep and pass its SDL log to vcctrl-cardid, so the")
    print("  card is identified from behaviour rather than from who fitted it.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted -- the target is left as it was\n")
        os._exit(130)
