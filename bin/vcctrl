#!/usr/bin/env bash
# vcctrl -- VM-side wrapper. Forwards to the daemon host over ssh.
#
# Deliberately thin: it holds no logic, so the same command works unchanged if
# Claude Code ever runs on the Pi itself (call `vcctrl` there directly).
set -euo pipefail

# The daemon host. Env wins, then vcctrl.yaml, and there is deliberately no
# hardcoded hostname left here: a wrapper that defaults to one rig's machine
# name makes a fresh clone look configured while talking to nothing.
# shellcheck source=../common/config.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/common/config.sh"
VCCTRL_HOST="${VCCTRL_HOST:-$(vc_cfg control.daemon_host "")}"
if [ -z "$VCCTRL_HOST" ]; then
  echo "vcctrl: no daemon host configured." >&2
  echo "  Set control.daemon_host in vcctrl.yaml (see vcctrl.example.yaml)," >&2
  echo "  or export VCCTRL_HOST=<ssh-destination>." >&2
  exit 3
fi

# ---------------------------------------------------------------------------
# CONNECTION MULTIPLEXING -- this is not a speed tweak, it is a fix for an
# outage. 2026-08-19 the Pi became unreachable for ~30 minutes: ping fine, TCP
# port 22 accepting, but sshd never sent a banner. Cause was
#
#     systemd-journald.service: Watchdog timeout (limit 3min)!
#
# repeating through the whole window. sshd, PAM and systemd-logind all write to
# journald, and when journald stops draining its socket those writers BLOCK --
# so sshd completes the TCP handshake in the kernel and then hangs before it
# can say hello. Nothing could be diagnosed at the time either, because the
# thing that failed was the thing that records failures.
#
# What saturated journald was this wrapper. Every call was a fresh ssh, every
# ssh spawned a full systemd user session -- dbus, pulseaudio, ~20 journal
# lines PER CALL -- and the harness makes a call per keystroke. 676 journal
# entries in one ten-minute window, onto an SD card, on a 920 MB Pi.
#
# ControlMaster collapses that: one authenticated connection is reused by every
# later call, so session setup happens once instead of thousands of times. It
# also removes most of the ~1.5 s per-call cost, which is the number that has
# produced four separate timing bugs in this harness.
#
# ControlPersist keeps the master alive between calls. If it dies, ssh silently
# opens a new one -- no failure mode is introduced, only a slow path.
SSH_CTL_DIR="${VCCTRL_SSH_CTL_DIR:-${TMPDIR:-/tmp}/vcctrl-ssh-$(id -u)}"
mkdir -p "$SSH_CTL_DIR" 2>/dev/null || true
chmod 700 "$SSH_CTL_DIR" 2>/dev/null || true

SSH_OPTS=(
  -o ControlMaster=auto
  -o "ControlPath=$SSH_CTL_DIR/%r@%h:%p"
  -o ControlPersist=300
  # Fail fast rather than hang forever. The outage above presented as calls
  # that never returned, which is indistinguishable from a long-running cell
  # and is why a wedged Pi went unnoticed for 13 minutes.
  -o ConnectTimeout=15
  -o ServerAliveInterval=10
  -o ServerAliveCountMax=3
)

if [[ $# -eq 0 ]]; then
  exec ssh "${SSH_OPTS[@]}" "$VCCTRL_HOST" vcctrl --help
fi

# ---------------------------------------------------------------------------
# --out / --out-dir MEAN THE CALLER'S DISK.
#
# Everything above forwards to the Pi, so before this the client's `--out` was
# a path on the PI. From the VM that is wrong in two ways. A path that does
# not exist there fails with an ENOENT that reads like a local permissions
# problem -- two rounds went into that on 2026-08-20. Far worse, a path that
# exists on BOTH machines succeeds and returns 0, and the caller then reads
# whatever ITS copy happens to hold: nothing, or a frame from an earlier run.
# That is exactly the stale-frame failure --out's two-valued contract was
# written to prevent, reappearing one host over where the contract cannot see
# it. The contract was sound; its scope was one machine and nothing said so.
#
# So: run to a temp path on the Pi, copy back, remove the remote copy.
#
# The alternative -- stream the bytes on stdout and let the shell redirect --
# is cleaner and is NOT used, because the shell creates the target file before
# the command runs. A failure would leave a zero-byte file behind, and a file
# that looks like evidence and is not is the thing this rig keeps producing.
# ---------------------------------------------------------------------------
local_out=""; out_flag=""; rdir=""; made_dir=0
args=()
for a in "$@"; do
  if [[ -n "$out_flag" && -z "$local_out" ]]; then
    local_out="$a"
    # Placeholder; replaced once we know the remote temp dir.
    args+=("@@REMOTE_OUT@@")
  else
    case "$a" in
      --out|--out-dir) out_flag="$a"; args+=("$a") ;;
      *) args+=("$a") ;;
    esac
  fi
done

if [[ -z "$local_out" ]]; then
  quoted=()
  for a in "${args[@]}"; do quoted+=("$(printf '%q' "$a")"); done
  exec ssh "${SSH_OPTS[@]}" "$VCCTRL_HOST" vcctrl "${quoted[@]}"
fi

# Refuse before touching the target if the destination cannot receive the
# file. Finding that out afterwards means a capture that succeeded on the Pi
# and was then thrown away.
dest_dir=$(dirname -- "$local_out")
if [[ ! -d "$dest_dir" ]]; then
  echo "vcctrl: $dest_dir does not exist, so $local_out cannot be written" >&2
  exit 3
fi
if [[ ! -w "$dest_dir" ]]; then
  echo "vcctrl: $dest_dir is not writable" >&2
  exit 3
fi

if [[ "$out_flag" == "--out-dir" ]]; then
  # We may have to remove this directory to honour the two-valued rule, so
  # refuse anything we would not be entitled to delete. Removing a directory
  # the caller named, that already held their files, is not a contract -- it
  # is data loss wearing one.
  if [[ -e "$local_out" && ! -d "$local_out" ]]; then
    echo "vcctrl: $local_out exists and is not a directory" >&2
    exit 3
  fi
  if [[ -d "$local_out" ]] && [[ -n "$(ls -A -- "$local_out" 2>/dev/null)" ]]; then
    echo "vcctrl: $local_out is not empty. Refusing, because a failed run has" >&2
    echo "  to leave no output behind and that would mean deleting your files." >&2
    exit 3
  fi
  [[ -d "$local_out" ]] || made_dir=1
fi

rdir="/tmp/vcctrl-out.$$.$RANDOM"
base=$(basename -- "$local_out")
if [[ "$out_flag" == "--out-dir" ]]; then
  remote_target="$rdir"
else
  remote_target="$rdir/$base"
fi

cleanup() { ssh "${SSH_OPTS[@]}" "$VCCTRL_HOST" "rm -rf -- $(printf '%q' "$rdir")" >/dev/null 2>&1 || true; }
trap cleanup EXIT

quoted=()
for a in "${args[@]}"; do
  [[ "$a" == "@@REMOTE_OUT@@" ]] && a="$remote_target"
  quoted+=("$(printf '%q' "$a")")
done

# `|| rc=$?` rather than a bare call: `set -e` is on, so a non-zero status
# would abort the script here and the cleanup below would never run.
# stdout is captured rather than passed through, because the client reports
# the path it wrote in its JSON -- and that is the path on the PI. Printing it
# unaltered hands a script an absolute path that does not exist on the machine
# reading it, which is the same class of defect as the rest of this file: a
# value that is real and is about something other than the question asked.
rc=0
remote_stdout=$(mktemp)
trap 'cleanup; rm -f -- "$remote_stdout"' EXIT
ssh "${SSH_OPTS[@]}" "$VCCTRL_HOST" \
  "mkdir -p $(printf '%q' "$rdir") && vcctrl ${quoted[*]}" \
  >"$remote_stdout" || rc=$?

# TWO-VALUED, ACROSS THE HOST BOUNDARY TOO. On any non-zero status the local
# destination must NOT exist afterwards -- otherwise a caller that does
# `vcctrl frame 42 --out f.jpg; analyse f.jpg` analyses the PREVIOUS run's
# file believing it is current, which is the precise failure the client's own
# contract exists to prevent.
if [[ $rc -ne 0 ]]; then
  if [[ "$out_flag" == "--out-dir" ]]; then
    # Only ever remove a directory we created ourselves, or one we already
    # verified was empty.
    rm -rf -- "$local_out" 2>/dev/null || true
  else
    rm -f -- "$local_out" 2>/dev/null || true
  fi
  exit $rc
fi

if [[ "$out_flag" == "--out-dir" ]]; then
  mkdir -p -- "$local_out" || { echo "vcctrl: cannot create $local_out" >&2; exit 3; }
  if ! scp -q "${SSH_OPTS[@]}" -r "$VCCTRL_HOST:$rdir/." "$local_out/" 2>/dev/null; then
    if [[ $made_dir -eq 1 ]]; then rm -rf -- "$local_out" 2>/dev/null || true
    else rm -rf -- "$local_out"/* 2>/dev/null || true; fi
    echo "vcctrl: the command succeeded on $VCCTRL_HOST but the copy back failed" >&2
    exit 3
  fi
else
  if ! scp -q "${SSH_OPTS[@]}" "$VCCTRL_HOST:$remote_target" "$local_out" 2>/dev/null; then
    rm -f -- "$local_out" 2>/dev/null || true
    echo "vcctrl: the command succeeded on $VCCTRL_HOST but the copy back failed" >&2
    exit 3
  fi
fi

# Rewrite the reported path to where the file actually IS. Falls back to
# printing the output unchanged if it is not JSON or python is unavailable --
# a cosmetic field is not worth failing a capture that succeeded.
python3 - "$remote_stdout" "$remote_target" "$rdir" "$local_out" <<'PYFILTER' 2>/dev/null \
  || cat -- "$remote_stdout"
import json, sys
raw = open(sys.argv[1]).read()
remote_file, remote_dir, local = sys.argv[2], sys.argv[3], sys.argv[4]
try:
    d = json.loads(raw)
except Exception:
    sys.stdout.write(raw)
    sys.exit(0)
for key, was in (("out", remote_file), ("out_dir", remote_dir)):
    if isinstance(d, dict) and d.get(key) == was:
        d[key] = local
sys.stdout.write(json.dumps(d, indent=2, sort_keys=True) + "\n")
PYFILTER
exit 0
