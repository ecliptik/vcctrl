#!/usr/bin/env python3
"""vcctrl-cfclean -- decide what may be deleted from the CF card, and refuse
to delete anything not PROVEN collected.

STATUS: THE DECISION HALF IS COMPLETE AND TESTED. THE CARD-DRIVING HALF IS NOT
WRITTEN, and this tool refuses at the top rather than pretending otherwise.
Reading `DIR LOGS\\<TAG>\\` back off the screen needs the Gateway, which was
not available when this was written. `parse_dir_summary()` and `classify_tag()`
below are the parts that decide what is safe, they are pure, and
`test_cfclean_never_deletes_what_it_cannot_prove` covers them -- including
against REAL OCR captured from the rig. What is missing is only issuing the
`DIR` and handing its OCR to the parser.

WHY THIS EXISTS. Frame dumps are 230,415 bytes each, four per cell, and they
are in neither glob:

    logback-qa.sh collects   *.LOG *.TXT *.CFG *.NFO      no *.PPM
    install-qa.sh clears     *.LOG *.TXT *.CFG            no *.PPM

Not collected, not cleared, invisible to both halves of the tooling meant to
manage exactly this. Nothing has been lost only because they have been pulled
by hand after every cell.

THE ONE HARD CONSTRAINT: NEVER DELETE ANYTHING NOT PROVEN COLLECTED.

Not "the copy returned success" -- PROVEN, by comparing CONTENT, per file.
This is destructive and irreversible on a machine that is a card swap away, and
the failure mode writes itself: A COLLECTION CHECK THAT CAN RETURN A FALSE YES
DELETES THE ONLY COPY. Every shape that produces a false yes has already
happened on this rig:

    all({}.values()) is True              a preflight passed on a missing field
    a clip check matched zero frames      and printed CLIP HOLDS
    count: 0 from a case-mismatched FIND  absence indistinguishable from a typo
    print gate open, collect gate shut    a well-formed zero meaning "not measured"

AND ONE MORE, FOUND BY TESTING THIS TOOL'S OWN INPUT: OCR reads DOS `DIR`
output with the SIZES right and the NAMES WRONG.

    real   R1A  LOG  1,102  08-20-26  10:58p
    OCR    RIA  LOG  1,102  88-20-26  18:58p

PPM filenames are `S<tick>.PPM` -- all digits -- so per-file name matching off
a listing cannot be made safe. **The card is therefore asked only for two
numbers: how many files, and how many bytes.** Both OCR correctly in every
sample. The local side supplies everything else, and a count-and-total match
over a directory is the proof. Three outcomes, never two.

DESIGN DECISIONS:

1. ROUND-SCOPED, BY DIRECTORY. Patch 0322 made a round's output a DIRECTORY
   (`LOGS\\<TAG>\\S<tick>.PPM`). So a directory-scoped cleanup CANNOT touch the
   historical flat `LOGS\\*.PPM` backlog even by accident. The backlog stays a
   separate, deliberate act -- answered structurally rather than by policy.

2. ABANDONED ROUNDS PROTECT THEMSELVES. From the card, uncollected and stale
   look identical. This tool never has to tell them apart: a file never
   collected has no local copy, so it never verifies, so it is never deleted.
   The rule that makes deletion safe is the rule that makes abandonment safe.

3. PPMs ONLY BY DEFAULT. Dumps are 230 KB and pure diagnostic. Text logs are
   ~150 KB per round and occasionally save a trip. `--logs` includes them under
   identical verification.

4. REFUSES UNLESS TOLD TWICE. Dry run is the default.
"""
import argparse
import os
import re
import sys

KEEP, DELETE, REFUSE = "KEEP", "DELETE", "REFUSE"


def local_index(incoming):
    """{BASENAME: [paths]} for everything that could serve as proof."""
    idx = {}
    for root, _dirs, files in os.walk(incoming):
        for f in files:
            idx.setdefault(f.upper(), []).append(os.path.join(root, f))
    return idx


def parse_dir_summary(ocr):
    """(count, total_bytes) from a DOS DIR summary, or None if unreadable.

    THIS IS THE ONLY THING WE READ OFF THE SCREEN, AND THAT IS DELIBERATE.

    Measured against real captures 2026-08-20: OCR reads DOS `DIR` output with
    the SIZES correct and the NAMES wrong.

        real   R1A  LOG  1,102  08-20-26  10:58p
        OCR    RIA  LOG  1,102  88-20-26  18:58p

    `R1A` -> `RIA`, `08` -> `88`, `10` -> `18`. The digit glyphs this console
    font produces are not reliably distinguishable -- the same defect that had
    `count: 0` reading as `count: @`.

    **PPM filenames are `S<tick>.PPM` -- ALL DIGITS.** So matching per-file by
    name off an OCR'd listing cannot be made safe, and a delete tool that does
    it is one glyph away from matching the wrong file. Sizes, counts and totals
    OCR correctly in every sample; names and dates do not.

    So the card is asked only for two numbers -- how many files and how many
    bytes -- and the local side supplies everything else.
    """
    if not ocr:
        return None
    # "  1 file(s)     122,485 bytes"  -- and OCR renders file(s) as filets),
    # fitets), file<s), so the word is not matched at all. The shape is:
    # <count> ... <bytes> bytes, on one line, and that is what is anchored on.
    for line in ocr.splitlines():
        m = re.search(r"(\d[\d,]*)\s+f\S*\s+([\d,]+)\s+bytes", line, re.I)
        if m:
            try:
                return (int(m.group(1).replace(",", "")),
                        int(m.group(2).replace(",", "")))
            except ValueError:
                return None
    return None


def local_tag_totals(incoming, tag, suffix=".PPM"):
    """(count, total_bytes) for a tag's collected files, or (0, 0)."""
    n = tot = 0
    for root, _dirs, files in os.walk(incoming):
        for f in files:
            if not f.upper().endswith(suffix.upper()):
                continue
            # 0322 puts a round's output in LOGS\<TAG>\, and the collect
            # mirrors that, so the tag is a path component. Fall back to a
            # prefix match for the pre-0322 flat layout.
            if tag.upper() in [p.upper() for p in root.split(os.sep)] \
               or f.upper().startswith(tag.upper()):
                try:
                    tot += os.path.getsize(os.path.join(root, f))
                    n += 1
                except OSError:
                    return None
    return (n, tot)


def classify_tag(card, local):
    """(verdict, reason) for a whole tag directory. Three outcomes, never two.

    DELETE  count AND total bytes both match -- the directory is collected
    KEEP    they differ, or nothing was collected
    REFUSE  either side could not be read

    Compares TOTALS rather than filenames because filenames are the part OCR
    gets wrong. A count-and-bytes match over a directory is strong evidence
    every file arrived; a per-name match built on misread digits is not
    evidence at all.
    """
    if card is None:
        return REFUSE, "could not read the card's DIR summary"
    if local is None:
        return REFUSE, "could not stat the local copies"
    cn, cb = card
    ln, lb = local
    if cn == 0:
        return KEEP, "nothing on the card for this tag"
    if ln == 0:
        return KEEP, "nothing collected locally -- never collected, or an " \
                     "abandoned round"
    if (cn, cb) == (ln, lb):
        return DELETE, "%d files / %d bytes match exactly" % (cn, cb)
    return KEEP, "card has %d/%d bytes, local has %d/%d -- NOT proven" % (
        cn, cb, ln, lb)


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--tags", required=True)
    ap.add_argument("--incoming",
                    default=os.path.expanduser("~/doskutsu-netiter/incoming"))
    ap.add_argument("--logs", action="store_true")
    ap.add_argument("--delete", action="store_true")
    a = ap.parse_args(argv)

    # REFUSE AT THE TOP. A tool that half-drives a destructive operation is
    # worse than one that declines: the operator reads a partial run as a
    # completed one. See docs/OPEN-FAULTS.md.
    print("REFUSED: the card-reading half of this tool is not written.")
    print()
    print("  parse_dir_summary() and classify_tag() decide what is safe and")
    print("  are tested against real OCR, but issuing the DIR and reading it")
    print("  `DIR LOGS\\<TAG>\\` back off the screen needs the Gateway, which")
    print("  was unavailable when this was written.")
    print()
    print("  What is missing is ONE call: issue `DIR LOGS\\<TAG>\\*.PPM`, hand")
    print("  the OCR to parse_dir_summary(), and pass its result to")
    print("  classify_tag(). A None from the parser must stay None.")
    print()
    print("  Do NOT wire it to a delete until that read has been exercised")
    print("  against a real card listing, including a truncated one.")
    return 2


if __name__ == "__main__":
    sys.exit(main())
