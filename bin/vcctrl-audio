#!/usr/bin/env python3
"""vcctrl-audio -- is the g2k actually making sound right now?

Answers one question cheaply: is audio present, and does it look like music
rather than hum? Not a recording tool and not a quality judgement -- the point
is to confirm a sound path is alive during a sweep, so a PicoGUS mode or a
Vibra card can be verified as working rather than assumed.

WHY IT IS NON-INVASIVE, WHICH IS THE USEFUL PART: audio comes off the capture
stick's ALSA device. Sampling it touches neither the keyboard nor /dev/video0,
so unlike every other liveness check in this harness it is safe to run DURING
a cell. That makes it the only observation channel that cannot perturb a
measured run.

ABSOLUTE LEVELS ARE NOT COMPARABLE ACROSS SESSIONS. The signal path is
speakers-headphone-out into the stick, so a physical volume knob sits in the
middle (FINDINGS sec. 11). A level that means "music" today can mean "silence"
tomorrow with no change to the machine. So:

  * digital silence is still unambiguous -- mean == max at the noise floor
    means no signal on the wire, not a low setting
  * anything above that is reported with its numbers, and compared to a
    baseline only if one is given

Reference points measured on this rig: working audio -30.8 dB mean against a
-65.6 dB noise floor; a disconnected or muted source reads about -91 dB with
mean equal to max, which is a constant rather than a floor.

Usage:
  vcctrl-audio [--seconds N] [--baseline DB]
"""

import os
import re
import subprocess
import sys
import time

HOST = os.environ.get("VCCTRL_HOST", "usb4vc")
DEV = os.environ.get("VCCTRL_ALSA", "hw:1,0")

# Below this, treat as no signal rather than quiet. Chosen well under the
# -65.6 dB noise floor so a genuinely idle-but-connected path reads as
# "connected and silent" rather than "disconnected".
FLOOR_DB = -80.0


# The daemon owns hw:1,0 for its lifetime now, so this tool cannot open the
# device itself -- it would get EBUSY. It reads the daemon's rolling PCM ring
# instead, which is both faster and, more importantly, keeps this tool's
# defining property intact: it still touches neither the keyboard nor
# /dev/video0, and now it touches no hardware at all, so it remains the one
# check that is safe to run DURING a measured cell.
VCCTRL_WEB = os.environ.get("VCCTRL_WEB", "http://100.64.0.1:8080")


def _daemon_alive(timeout=2.0):
    try:
        import urllib.request
        with urllib.request.urlopen("%s/state.json" % VCCTRL_WEB, timeout=timeout):
            return True
    except Exception:
        return False


def measure(seconds):
    """Returns (mean_db, peak_db, histogram, raw_text).

    Numbers come from the daemon and are the same scale as before: validated
    against `ffmpeg -af volumedetect` on synthetic signals at -20, -40 and
    -60 dBFS, matching mean and peak to within 0.07 dB and reproducing
    ffmpeg's bucket count exactly. That matters because every reference level
    in FINDINGS -- the -30.8 dB working figure, the -65.6 dB floor -- was read
    off volumedetect, and a shifted scale would silently invalidate all of it.
    """
    import json
    import urllib.error
    import urllib.request
    url = "%s/cmd" % VCCTRL_WEB
    body = json.dumps({"cmd": "level", "ms": int(seconds * 1000)}).encode()
    req = urllib.request.Request(url, data=body,
                                 headers={"Content-Type": "application/json"})
    last = None
    for attempt in (1, 2):
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                d = json.loads(r.read())
            if not d.get("ok") or d.get("mean_db") is None:
                return None, None, {}, ("daemon returned no level: %s"
                                        % d.get("reason", d))
            hist = {int(k): v for k, v in (d.get("hist") or {}).items()}
            return (d["mean_db"], d["peak_db"], hist,
                    "from daemon ring, %s ms, state=%s, buckets=%d"
                    % (d.get("window_ms"), d.get("state"), d.get("buckets", 0)))
        except Exception as exc:
            last = exc
            if attempt == 1:
                time.sleep(0.4)

    # Same rule as grab(): do not fall back into a capture that cannot work.
    # The daemon holds hw:1,0, so a direct ffmpeg would hit EBUSY and report
    # "no signal" -- a false reading, not a failure to read.
    if _daemon_alive():
        return None, None, {}, (
            "daemon is up but served no level (%s). NOT falling back to a "
            "direct capture -- it holds hw:1,0, so ffmpeg would get EBUSY and "
            "report a false NO SIGNAL." % last)

    sys.stderr.write("vcctrl-audio: daemon unreachable (%s), sampling the "
                     "device directly\n" % last)
    return _measure_ffmpeg(seconds)


def _measure_ffmpeg(seconds):
    """The original path, kept for a daemon that is down."""
    r = subprocess.run(
        ["ssh", HOST,
         "ffmpeg -hide_banner -f alsa -i %s -t %d -af volumedetect -f null - 2>&1"
         % (DEV, seconds)],
        capture_output=True, text=True)
    out = r.stdout + r.stderr
    def find(k):
        m = re.search(r"%s:\s*(-?[\d.]+) dB" % k, out)
        return float(m.group(1)) if m else None
    hist = {}
    for m in re.finditer(r"histogram_(\d+)db:\s*(\d+)", out):
        hist[int(m.group(1))] = int(m.group(2))
    return find("mean_volume"), find("max_volume"), hist, out


def main(argv):
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass
    seconds = 5
    if "--seconds" in argv:
        seconds = int(argv[argv.index("--seconds") + 1])
    baseline = None
    if "--baseline" in argv:
        baseline = float(argv[argv.index("--baseline") + 1])

    mean, peak, hist, raw = measure(seconds)
    if mean is None:
        print("REFUSED: could not read a level. Device %s on %s."
              % (DEV, HOST))
        print(raw.strip()[-400:])
        return 2

    print("== audio, %ds sample ==" % seconds)
    print("  mean %.1f dB   peak %.1f dB" % (mean, peak))

    # A constant signal has mean == max. Real audio, even near-silence, has a
    # spread -- there is always dither and analog noise. This distinguishes
    # "nothing on the wire" from "connected but quiet", which a threshold on
    # the mean alone cannot do.
    flat = abs(mean - peak) < 0.05
    if flat and mean <= FLOOR_DB:
        print("  VERDICT: NO SIGNAL")
        print("  mean equals peak at the floor -- that is a constant, not a")
        print("  quiet passage. The source is disconnected, powered off, or")
        print("  muted at the hardware. A low volume KNOB does not look like")
        print("  this; it still carries noise.")
        return 1
    if mean <= FLOOR_DB:
        print("  VERDICT: SILENT (but connected)")
        print("  there is a noise floor, so the path is intact and nothing is")
        print("  playing. Expected at a DOS prompt; a fault during a cell.")
        return 1

    spread = peak - mean
    print("  dynamic spread %.1f dB across %d histogram buckets"
          % (spread, len(hist)))
    if baseline is not None:
        print("  baseline %.1f dB -> %+.1f dB" % (baseline, mean - baseline))
    print("  VERDICT: AUDIO PRESENT")
    if spread < 3.0:
        print("  NOTE: peak sits close to mean, which is more like a steady")
        print("  tone or hum than music. Music has a wide spread. Worth a")
        print("  listen before calling this a working sound path.")
    else:
        print("  spread is wide, which is what music looks like rather than a")
        print("  steady tone. This does NOT verify the right notes -- only")
        print("  that a varying signal is present.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        os._exit(0)
