[Unit]
Description=vcctrl read-only public KVM mirror (daemon/vcweb_public.py)
# Ordering only, deliberately -- this must be able to run, restart or fail
# independently of vcctrld. See the module docstring in vcweb_public.py:
# it shares no code path with vcctrld's command dispatch, so there is
# nothing here for a `Requires=`/`Wants=` to protect.
After=vcctrld.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/vcctrl/vcweb_public.py
# See vcctrl.example.yaml's daemon.web_public block for what these mean and
# why they are env vars here rather than a second YAML load. upstream_port
# MUST match the private daemon's own daemon.web.port.
Environment=VCCTRL_PUBLIC_BIND=127.0.0.1
Environment=VCCTRL_PUBLIC_PORT=8091
Environment=VCCTRL_WEB_PORT=8080
Restart=always
RestartSec=2
# WHERE TELEMETRY PERSISTS -- NOT /opt/vcctrl (root:root 755; `vcctrl-ro`
# cannot write there, see vcweb_public.py's own STATE_DIR comment).
# StateDirectory= creates and chows this to User= below automatically, the
# same mechanism tailscaled-ro.service already uses for its own state dir.
Environment=VCCTRL_PUBLIC_STATE_DIR=/var/lib/vcctrl-web-public
StateDirectory=vcctrl-web-public
StateDirectoryMode=0700
# UNPRIVILEGED, AND NOT AS `pi` -- this process never touches /dev/uinput
# or any device, it only ever makes loopback HTTP GET requests to the
# private daemon's already-read-only endpoints, but `pi` carries group
# memberships (`input` above all -- see pi/install.sh's ensure_vcctrl_ro_user()
# for the full reasoning) it has no use for and that a bug here would
# otherwise inherit for free. `vcctrl-ro` is a dedicated system user with no
# shell, no password and no supplementary groups, created idempotently by
# pi/install.sh before this unit starts.
User=vcctrl-ro

[Install]
WantedBy=multi-user.target

# --------------------------------------------------------------------------
# WIRED INTO pi/install.sh's install_public() (and pi/deploy.sh --public /
# --public-only), which installs this unit, copies vcweb_public.py,
# kvm-ro.html and themes.css into /opt/vcctrl, and calls
# install_tailscaled_ro() -- see tailscaled-ro.service and its own comment.
#
# EXPOSURE: ITS OWN TAILNET IDENTITY, NOT A PORT ON THE CONTROL HOSTNAME.
# This mirror used to live at https://<control-hostname>:10000/ -- an
# alternate port on the SAME Tailscale node as the private control UI, so
# its ACL/exposure surface was entangled with the control node's. It now has
# a second, unprivileged `tailscaled` instance of its own
# (tailscaled-ro.service, socket /run/tailscale-ro/tailscaled.sock), mapping
#   https://<ro-hostname>.<tailnet>.ts.net/ -> http://127.0.0.1:8091 (this service)
# where <ro-hostname> is whatever hostname that instance registered under
# (`tailscale up --socket=/run/tailscale-ro/tailscaled.sock ...`, a one-time
# MANUAL operator step -- see install_tailscaled_ro()'s own comment; this
# unit's own service never runs `tailscale up` or `tailscale funnel`). For a
# quick look without touching tailscale config at all:
#   ssh -L 8091:127.0.0.1:8091 pi@<tailnet-host>
#
# THE FUNNEL-PORTS ACL GRANT IS PER NODE, NOT PER TAILNET -- LEARNED THE
# HARD WAY, TWICE. First as the reason the old setup used port 10000 rather
# than 8091 externally (a tailnet's ACL grants Funnel only on specific
# ports, via the `funnel-ports` node capability -- check `tailscale status
# --json` -> Self.CapMap; commonly 443, 8443, 10000 by Tailscale's own
# default -- and Funnel on a port outside that grant reports success
# locally with NO warning at all, discovered only by testing from a device
# genuinely off the tailnet). Second, bringing up this RO node's own
# identity: TAGGING a freshly-registered node can silently DROP capabilities
# it had while untagged (this one lost `funnel`/`funnel-ports` the moment
# `tag:vcctrl-kvm-ro` was applied, because it had been inheriting them from
# the registering owner identity, not from any grant to the tag) -- the
# tag's own ACL policy needs an explicit `nodeAttrs` grant
# (`{"target": ["tag:vcctrl-kvm-ro"], "attr": ["funnel"]}` or equivalent)
# before Funnel works again. Same discipline both times: check
# `tailscale --socket=/run/tailscale-ro/tailscaled.sock status --json` ->
# Self.CapMap on the LIVE instance before trusting a port or a tag, and
# confirm reachability from a device genuinely off the tailnet before
# treating Funnel as working.
