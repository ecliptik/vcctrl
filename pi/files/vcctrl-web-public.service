[Unit]
Description=vcctrl read-only public KVM mirror (daemon/vcweb_public.py)
# Ordering only, deliberately -- this must be able to run, restart or fail
# independently of vcctrld. See the module docstring in vcweb_public.py:
# it shares no code path with vcctrld's command dispatch, so there is
# nothing here for a `Requires=`/`Wants=` to protect.
After=vcctrld.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/vcctrl/vcweb_public.py
# See vcctrl.example.yaml's daemon.web_public block for what these mean and
# why they are env vars here rather than a second YAML load. upstream_port
# MUST match the private daemon's own daemon.web.port.
Environment=VCCTRL_PUBLIC_BIND=127.0.0.1
Environment=VCCTRL_PUBLIC_PORT=8091
Environment=VCCTRL_WEB_PORT=8080
Restart=always
RestartSec=2
# Unprivileged on purpose, unlike vcctrld: this process never touches
# /dev/uinput or any device, it only ever makes loopback HTTP GET requests
# to the private daemon's already-read-only endpoints.
User=pi

[Install]
WantedBy=multi-user.target

# --------------------------------------------------------------------------
# WIRED INTO pi/install.sh's install_public() (and pi/deploy.sh --public /
# --public-only), which installs this unit, copies vcweb_public.py,
# kvm-ro.html and themes.css into /opt/vcctrl, and sets up the tailnet-only
# `tailscale serve` mapping below -- one code path, not copied here.
#
# EXPOSURE: TAILNET-ONLY BY DEFAULT. install_public() maps
#   https://<tailnet-host>:10000/ -> http://127.0.0.1:8091 (this service)
# reachable to the tailnet the same way the control UI is (or, for a quick
# look without touching `tailscale serve` config at all:
#   ssh -L 8091:127.0.0.1:8091 pi@<tailnet-host>
# ).
#
# PORT 10000, NOT 8091 or 8443 -- LEARNED THE HARD WAY. The external port
# above is 10000, not this service's own VCCTRL_PUBLIC_PORT (8091): making
# this reachable from the OPEN INTERNET is a separate, later, manual
# `tailscale funnel` step the operator takes after reviewing it over the
# tailnet (this unit does not run funnel, and nothing in vcweb_public.py
# assumes it ever will be) -- but `tailscale funnel` only actually reaches
# the public internet on ports the tailnet's own ACL grants this node via
# the `funnel-ports` node capability (check `tailscale status --json` ->
# Self.CapMap; commonly 443, 8443, 10000 by Tailscale's own default).
# Funnel on a port outside that grant reports success locally (AllowFunnel:
# true, HTTPS: true, `tailscale funnel status` shows "Funnel on") with NO
# warning at all, and is simply never reachable from outside the tailnet --
# discovered only by testing from a device genuinely off the tailnet, which
# is exactly how this was found. 10000 is the one of the three commonly-
# granted defaults not already spoken for by the private KVM (443, 8443).
