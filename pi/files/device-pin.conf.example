# Capture devices pinned BY NAME, not by index.
#
# Both defaults happened to be correct when this was written -- the stick came
# up as ALSA card 1 and /dev/video0 -- but that is luck, not a guarantee. This
# machine has vc4hdmi0 at card 0 and vc4hdmi1 at card 2, so a different
# enumeration order puts an HDMI OUTPUT at index 1 and the daemon would capture
# silence from it without ever saying anything was wrong. Naming the device
# turns that failure from "wrong audio" into "device_present: false", which is
# a fault someone can see.
#
# THESE ARE SPECIFIC TO THE MACROSILICON VGA STICK. The Macintosh path uses
# RGB2HDMI into a different capture device, which will have a different card id
# and a different by-id path -- update this file when that stick goes in. The
# failure if you forget is loud (device absent) rather than quiet, which is the
# point.
[Service]
Environment=VCCTRL_ALSA=hw:CARD=REPLACE_ME,DEV=0
Environment=VCCTRL_VIDEO=/dev/v4l/by-id/REPLACE_ME-video-index0
