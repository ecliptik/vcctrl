#!/usr/bin/env python3
"""vcctrl-sweep -- drive a doskutsu QA sweep on the g2k unattended.

Runs on the VM. Orchestrates vcctrl (input + capture + power) around the DOS
side's own contract. That contract is the reason this looks the way it does:

  * The harness drives SWEEPS, NOT CELLS. Inside a sweep there is no shell
    reading a command line -- the BAT is still executing -- so a keystroke sent
    mid-sweep lands in the BIOS buffer and is either eaten by the next PAUSE or
    leaks into the next cell's game process. There are exactly two reliable
    injection points: the single PAUSE at the top of a sweep, and the real
    prompt between sweeps.

  * Therefore liveness during a sweep may NEVER be probed by keyboard. It is
    judged from wall-clock against a measured budget (primary) and frame-delta
    on the capture stick (secondary, corroborating only). A cell can legitimately
    hold a near-static frame for a long stretch, so frame-delta alone would
    manufacture false wedges.

  * A timeout is not necessarily a wedge. A stale Organya cache legitimately
    runs 3-4x long, and no amount of rebooting fixes it. Classification comes
    before escalation.

Usage:
  vcctrl-sweep <SWEEP> <machine-digit> [--dry-run] [--no-power-recovery]
                                       [--collect] [--power-on]
  vcctrl-sweep --list

  --power-on  bring the target up if it is off, instead of refusing. Uses an
              LED edge pair, not a level -- see vcctrl_common.wait_cold_boot.
  --collect   on completion, hand off to vcctrl-collect: reboot into NET,
              PUT every cell log, and confirm each one landed. Without it the
              sweep ends with the logs still on the card.
"""

import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
# The shared library stayed in bin/ when the harness moved to harness/.
# vcctrl_common is NOT harness code -- vcctrl-audio, -capcheck and -cfclean all
# import it, and moving it here would have made the general capture tools
# depend on the doskutsu harness, which is the coupling this split exists to
# remove. See docs/CONFIG-PLAN.md sec. 6.
BIN = os.path.join(os.path.dirname(HERE), "bin")
sys.path.insert(0, BIN)
sys.path.insert(0, HERE)
from vcctrl_common import (  # noqa: E402
    vc, vc_json, at_prompt, ensure_powered, set_lock_owner, get_lock_owner,
    cfg_get, grab, VCCTRL_WEB, _daemon_alive, _daemon_host, _has_variance,
    _grab_ffmpeg)

# THE PROFILE, not sweeps.json. Phase 6 moved the machine table and the
# per-sweep budgets into profiles/doskutsu.yaml alongside the target facts they
# belong with -- the DOS working directory, the env-var names the program
# consults, and the boot-profile witness. One file describing one target beats
# a data file here and prose about the same target in three other places.
#
# Located through vcctrl.yaml's `harness.profile` so a different port points at
# a different profile without editing the runner. Falls back to the doskutsu
# profile beside this file, which is what a checkout with no config has.
def _profile_path():
    try:
        p = cfg_get("harness.profile", "") or ""
    except Exception:
        p = ""
    if p and not os.path.isabs(p):
        p = os.path.join(os.path.dirname(HERE), p)
    return p or os.path.join(os.path.dirname(HERE), "profiles", "doskutsu.yaml")


CONF = _profile_path()


def _load_profile():
    """The profile as a dict. Raises with the path in the message: a runner that
    cannot find its profile must say which one it looked for, or the operator
    debugs the wrong file."""
    try:
        import yaml
    except ImportError:
        raise SystemExit(
            "REFUSED: PyYAML is needed to read %s (apt install python3-yaml)"
            % CONF)
    try:
        with open(CONF) as f:
            d = yaml.safe_load(f) or {}
    except OSError as exc:
        raise SystemExit("REFUSED: cannot read the harness profile %s: %s"
                         % (CONF, exc))
    if not d.get("sweeps") or not d.get("machines"):
        raise SystemExit(
            "REFUSED: %s has no sweeps/machines -- it is not a harness profile"
            % CONF)
    return d

# Screen must be still for this long before the runner will believe a sweep has
# ended. During a cell the game renders continuously; at a prompt the screen is
# static. Between cells the console is static only for seconds, so a window this
# wide will not mistake an inter-cell gap for completion.
STILL_SECONDS = 45
# Do not even start looking for completion until this fraction of the measured
# span has elapsed. Guards against a slow first cell reading as "done".
EARLIEST_COMPLETION = 0.5
POLL_SECONDS = 15


# The daemon owns /dev/video0 for its lifetime now (docs/WEBKVM.md sec. 4), so
# a caller cannot open the device itself -- it would get EBUSY. It also means a
# frame is already captured before anyone asks for one, which is why this went
# from ~40 s to well under a second.
# VCCTRL_WEB, grab() and its three helpers moved to bin/vcctrl_common.py in
# phase 6. They are capture infrastructure -- HTTP to the daemon, a retry, a
# variance test -- not sweep logic, and leaving them here meant the shared
# library had to reach into harness/ for one function, which every importer
# of that library then inherited. Imported like any other daemon primitive
# now; see the note above them in vcctrl_common.

def frame_signature(path):
    """Coarse fingerprint of a frame, for change detection between polls."""
    from PIL import Image
    im = Image.open(path).convert("L").resize((32, 24))
    return list(im.getdata())


def sig_differs(a, b, threshold=8):
    """Compare two frame signatures. `b` MUST NOT be None.

    The previous version returned True when either argument was None, which
    made a no-picture poll score as MOVEMENT: `sig` was None, this returned
    True, `still_since` reset, and the watch loop printed "changing still 0s"
    for six minutes against a black screen. A wedge produced the healthiest
    possible output the loop can print.

    Raising on a null `b` rather than guessing makes that reintroducible only
    by deleting this check. No-picture is a third state and belongs to the
    caller -- see StallTracker.
    """
    if b is None:
        raise ValueError(
            "sig_differs received a null signature. No-picture is a third "
            "state, not a difference; handle it in the caller.")
    if a is None:
        return True          # nothing to compare against yet: first poll
    diff = sum(1 for x, y in zip(a, b) if abs(x - y) > threshold)
    return diff > len(a) * 0.02


# Consecutive polls with no picture before the watch loop stops waiting. At
# POLL_SECONDS this is a couple of minutes -- long enough to ride out the
# capture stick's intermittent flat frames and a mode change, short enough
# that six minutes of a black screen cannot pass as a healthy run.
BLIND_POLLS_MAX = 20


class StallTracker(object):
    """Three-state classification of a poll: changing, static, or blind.

    Extracted from the watch loop so it can be tested without a sweep, a
    target, or a capture stick. The bug it replaces was only ever observable
    on hardware, in a log that was later deleted, which is a bad place for the
    only copy of a regression to live.
    """

    def __init__(self, blind_limit=BLIND_POLLS_MAX):
        self.last_sig = None
        self.still_since = None
        self.blind = 0
        self.blind_limit = blind_limit

    def update(self, sig, now=None):
        now = time.time() if now is None else now
        if sig is None:
            self.blind += 1
            # last_sig is deliberately NOT cleared. The next real frame has to
            # be compared against the last frame actually seen, not against
            # the gap -- otherwise the first frame after a blind spell reports
            # movement whether or not anything moved, and the blind spell
            # launders itself into evidence of life.
            return {"state": "blind", "blind": self.blind, "still": 0.0,
                    "escalate": self.blind >= self.blind_limit}
        self.blind = 0
        changed = sig_differs(self.last_sig, sig)
        self.last_sig = sig
        if changed:
            self.still_since = None
        elif self.still_since is None:
            self.still_since = now
        still = 0.0 if self.still_since is None else now - self.still_since
        return {"state": "changing" if changed else "static", "blind": 0,
                "still": still, "escalate": False}


LOCK_AS = "sweep"


def take_lock(sweep, machine):
    """Hold the input lock for the whole run, and answer to it ourselves.

    A sweep is the longest uninterruptible thing this harness does and the one
    with the narrowest safe injection window: once the PAUSE is answered there
    is no shell reading a command line, so a keystroke from anywhere else lands
    in the BIOS buffer and leaks into the next cell's game process. That is not
    a crash, it is a QUIET corruption of a measurement -- the run completes,
    the logs look fine, and one cell saw an input the others did not.

    Two failure modes, both already paid for elsewhere in this tree:

      * Not taking the lock at all. `vcctrl-cell` takes one; this did not, so
        for its whole life a sweep could be typed into by any other session
        with nothing to stop it and nothing to record that it happened.
      * Taking it and not setting LOCK_OWNER, which locks the harness out of
        its own keyboard -- every `vc("type", ...)` below is refused by the
        daemon. `vcctrl-cell` did exactly this the first time and died holding
        a lock it could not name.

    Refuses rather than proceeds if someone else holds it: a sweep sharing the
    machine with another session is not a measurement worth spending 20 minutes
    on. Refuses rather than proceeds if the lock is UNAVAILABLE too -- unlike a
    cell, which degrades to a warning, because a cell can be re-run cheaply and
    the corruption here is silent.
    """
    owner = "%s-%s%s" % (LOCK_AS, sweep, machine)
    st = vc_json("lock", "status")
    held = st.get("owner")
    if held:
        raise SystemExit(
            "REFUSED: the input lock is held by %r (%.0fs).\n"
            "  Another session is driving the target. Two writers on one\n"
            "  keyboard during a sweep produces a run that completes and\n"
            "  cannot be trusted, which is worse than one that fails."
            % (held, st.get("held_s") or 0))
    vc("lock", "acquire", "--as", owner)
    set_lock_owner(owner)
    print("  input lock held as %s" % owner)
    return owner


def drop_lock(why):
    owner = get_lock_owner()
    if not owner:
        return
    print("  releasing the input lock (%s)" % why)
    try:
        vc("lock", "release", "--as", owner, check=False)
    finally:
        set_lock_owner(None)


def load_conf():
    return _load_profile()


def preflight(conf, sweep, machine, allow_power_on=False):
    print("== preflight ==")
    if sweep in conf["denied"]:
        raise SystemExit("REFUSED: %s is deny-listed.\n  %s" % (sweep, conf["denied"][sweep]))
    if sweep not in conf["sweeps"]:
        raise SystemExit("REFUSED: %s has no measured span, so no defensible timeout.\n"
                         "  A timeout guessed too tight turns a healthy sweep into a\n"
                         "  spurious wedge and then a power cycle. Measure it attended first."
                         % sweep)
    if machine not in conf["machines"]:
        raise SystemExit("REFUSED: unknown machine digit %r" % machine)

    st = vc_json("status")
    held = st.get("usb4vc")
    # `all({}.values())` is TRUE. With `st.get("usb4vc", {})` this check passed
    # vacuously whenever the field was missing -- an absent answer read as a
    # clean bill of health, immediately before committing the machine to a
    # 23-minute unattended run it could not verify. A check that cannot fail
    # when the information is missing is worse than no check, because it
    # produces the same output as a real pass.
    if held is None:
        raise SystemExit(
            "REFUSED: `status` did not report a usb4vc hold state at all.\n"
            "  That is NOT the same as the devices being held. Something is\n"
            "  wrong with the daemon or the field has been renamed, and\n"
            "  either way this cannot confirm the input path.")
    if not held:
        raise SystemExit(
            "REFUSED: usb4vc reported an EMPTY hold state: %r\n"
            "  No devices listed means none confirmed held." % (held,))
    if not all(held.values()):
        raise SystemExit("REFUSED: USB4VC is not holding our input devices: %s" % held)
    print("  input devices held by USB4VC: ok (%s)"
          % ", ".join(sorted(held)))

    if not ensure_powered(allow_power_on):
        raise SystemExit(2)
    return conf["sweeps"][sweep], conf["machines"][machine]


def main(argv):
    # Line-buffer stdout. These are long jobs that are usually run in the
    # background, and Python block-buffers to a pipe -- which meant a 23-minute
    # sweep reported absolutely nothing until it exited. Progress you cannot
    # see during the run is not progress you can supervise.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:
        pass
    conf = load_conf()
    if not argv or argv[0] == "--list":
        print("sweeps with a measured span (runnable):")
        for k, v in sorted(conf["sweeps"].items()):
            print("  %-6s %d cells  timeout %2d min   (%s)" %
                  (k, v["cells"], v["timeout_min"], v["measured"]))
        print("\ndeny-listed:")
        for k, v in sorted(conf["denied"].items()):
            print("  %-6s %s" % (k, v))
        return 0

    if len(argv) < 2:
        print(__doc__)
        return 2
    sweep, machine = argv[0].upper(), argv[1]
    dry = "--dry-run" in argv
    recover = "--no-power-recovery" not in argv
    collect = "--collect" in argv
    allow_power_on = "--power-on" in argv

    # Declared hardware (doskutsu harness profile sec. 3.6). QA.BAT takes it
    # as optional positional args and rides it into every sweep manifest in
    # the boot. Without it the manifest field reads UNDECLARED, which is
    # honest but makes every cell provisional at L3. Absent flags are left
    # empty on purpose -- "nobody said" is a real state and must not be
    # defaulted into a claim.
    def _opt(flag):
        # Two ways this goes wrong, both resolving to "" because an empty
        # declared field is honest and a forged one is not. IndexError when the
        # flag is the final argument; and `--video --sound PICOGUS` silently
        # taking "--sound" as the video name, which would declare a lie.
        if flag not in argv:
            return ""
        i = argv.index(flag) + 1
        if i >= len(argv):
            return ""
        v = argv[i]
        return "" if v.startswith("--") else v
    declare = " ".join(x for x in (_opt("--video"), _opt("--sound"),
                                   _opt("--irq")) if x)

    spec, mach = preflight(conf, sweep, machine, allow_power_on)
    budget = spec["timeout_min"] * 60
    print("  sweep %s: %d cells, budget %d min, machine %s (%s)" %
          (sweep, spec["cells"], spec["timeout_min"], mach["tag"], mach["name"]))

    take_lock(sweep, machine)

    # AFTER the lock, deliberately: at_prompt() taps a key, so it is input and
    # the daemon refuses it to anyone who is not the holder. Probing first and
    # locking second would mean the probe either ran unlocked or failed for a
    # reason that reads as "the target is wedged".
    if not at_prompt():
        raise SystemExit("REFUSED: target did not answer the LED probe -- it is not at a\n"
                         "  prompt, or something is still running. Not typing into that.")
    print("  target is at a prompt: ok")

    if collect:
        spec_tags = spec.get("tags")
        if not spec_tags:
            raise SystemExit("REFUSED: --collect but %s has no tags in sweeps.json." % sweep)
        print("  will collect: %s" % " ".join(mach["tag"] + t for t in spec_tags))

    if dry:
        print("\n-- dry run, stopping before launch --")
        return 0

    print("\n== launch ==")
    vc("type", "CD \\DOSKUTSU"); vc("key", "enter"); time.sleep(1)
    qa_line = ("QA %s %s" % (machine, declare)).rstrip()
    print("  declaring: %s" % (declare or "(nothing -- manifest will say UNDECLARED)"))
    vc("type", qa_line); vc("key", "enter"); time.sleep(3)
    vc("type", "SET DKTCAP=1"); vc("key", "enter"); time.sleep(2)
    vc("type", "%s %s" % (sweep, machine)); vc("key", "enter")
    time.sleep(10)

    shot, mean = grab("sweep-banner")
    print("  banner captured: %s (brightness %.1f)" % (shot, mean or -1))
    print("  CHECK THIS IMAGE for '[DKTCAP=1] capture session:' before trusting the run.")

    print("  pressing the PAUSE key -- from here the keyboard is OFF LIMITS")
    vc("key", "space")
    t0 = time.time()

    print("\n== monitor (%d min budget) ==" % spec["timeout_min"])
    tracker = StallTracker()
    while True:
        elapsed = time.time() - t0
        if elapsed > budget:
            print("\n!! TIMEOUT after %.1f min" % (elapsed / 60))
            return on_timeout(sweep, mach, recover)
        time.sleep(POLL_SECONDS)
        shot, mean = grab("sweep-poll")
        sig = frame_signature(shot) if shot else None
        st = tracker.update(sig)
        changed, still = st["state"] == "changing", st["still"]

        if st["state"] == "blind":
            print("  t+%5.1f min  NO PICTURE (%d consecutive) -- cannot tell "
                  "a running sweep from a wedged one" % (elapsed / 60, st["blind"]))
            if st["escalate"]:
                blind_min = st["blind"] * POLL_SECONDS / 60.0
                print("\n!! %d consecutive polls with no picture (%.1f min)."
                      % (st["blind"], blind_min))
                print("   This is NOT stillness and NOT movement. The harness has")
                print("   been unable to see the target at all. Scoring it as")
                print("   movement is why a black screen once read as a healthy")
                print("   run for six minutes.")
                return on_timeout(sweep, mach, recover)
            continue

        print("  t+%5.1f min  brightness %5.1f  %s  still %ds" %
              (elapsed / 60, mean or -1, st["state"], still))

        if elapsed > budget * EARLIEST_COMPLETION and still >= STILL_SECONDS:
            print("\n== screen static for %ds past %.0f%% of budget -- probing ==" %
                  (STILL_SECONDS, EARLIEST_COMPLETION * 100))
            if at_prompt():
                print("\n== COMPLETE after %.1f min ==" % (elapsed / 60))
                grab("sweep-done")
                if not collect:
                    print("  logs are on the CF card under C:\\DOSKUTSU\\LOGS")
                    print("  collect them with:  vcctrl-collect %s %s" % (sweep, machine))
                    return 0
                # Hand off rather than reimplement. The collector reboots, and
                # a reboot is only safe from the prompt we have just proven is
                # live -- so this is the one moment it can be started with no
                # further checking.
                print("\n-- handing off to vcctrl-collect --")
                # The collector types: it reboots and drives PUT. It does not
                # know our lock identity, so holding on here would refuse every
                # keystroke it sends. Hand the keyboard over cleanly rather
                # than leave it half-owned.
                drop_lock("handing the keyboard to vcctrl-collect")
                return subprocess.call(
                    [os.path.join(HERE, "vcctrl-collect"), sweep, machine])
            print("  no prompt -- still running, continuing to watch")
            still_since = None


def on_timeout(sweep, mach, recover):
    """A timeout is not necessarily a wedge. Classify before escalating."""
    print("  classifying before escalating...")
    grab("sweep-timeout")
    print("""
  A timeout has THREE common causes and only one is fixed by rebooting:

    1. Stale Organya cache -- the cell cold-renders and sits on a loading
       screen for minutes. Runs 3-4x long. A reboot does NOT fix this; the
       cache must be re-rendered. The engine logs a cache-key line at startup
       and a mismatch is the signature.
    2. A genuine wedge -- reboot is the fix.
    3. The budget was wrong for this machine.

  Check sweep-timeout.jpg before doing anything. If it shows a loading screen
  rather than a frozen frame, this is case 1 and power-cycling will loop
  forever without fixing it.
""")
    if not recover:
        print("  --no-power-recovery set: stopping without touching the machine.")
        return 1
    print("  NOT power-cycling automatically: cause is unclassified, and cycling")
    print("  a stale-cache run would burn the night without fixing anything.")
    print("  To recover manually:  vcctrl power cycle")
    return 1


if __name__ == "__main__":
    # Every exit path drops the lock, including the two that call os._exit and
    # therefore skip `finally` entirely. A lock left held by a dead process is
    # not a safety margin -- it is a machine nobody can drive, and the only way
    # out is `lock break`, which marks the next run TAINTED.
    try:
        try:
            code = main(sys.argv[1:])
        finally:
            drop_lock("run finished")
        sys.exit(code)
    except BrokenPipeError:
        # Line-buffered output means `| head` closes the pipe under us. That is
        # the reader's choice, not an error worth a traceback.
        drop_lock("output pipe closed")
        os._exit(0)
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted -- the target is left as it was\n")
        drop_lock("interrupted")
        os._exit(130)
