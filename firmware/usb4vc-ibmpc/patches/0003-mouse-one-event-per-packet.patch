+/*
+ * vcctrl local patch 0003: ONE EVENT, ONE PACKET, AT THE SPACING IT WAS SENT.
+ *
+ * Stock firmware sums every queued event into one packet, which made sense
+ * for a 1000 Hz USB mouse feeding a 200 Hz PS/2 port. vcctrl sends paced
+ * moves that must reach the host as separate packets: the driver clamps the
+ * pointer at the screen edge PER PACKET, and a game that polls about every
+ * 33 ms sums whatever arrived between two polls.
+ *
+ * Measured 2026-11-11, dosags round RK, cell RKM1, firmware 0.5.108. Patch
+ * 0002 held one packet through a 1,247 ms host stall and delivered it whole.
+ * But the press's later moves had queued behind it and were summed into one
+ * packet, and the next press's moves arrived in the same burst. The game
+ * applied press 91's click at press 92's landing point.
+ *
+ * So, while the queue is not about to overflow:
+ *   - one queued event per packet, in order. A button edge is never merged
+ *     with, or reordered against, the moves around it.
+ *   - each packet waits until at least the gap that separated its event from
+ *     the previous one when they ARRIVED, capped at VC_SPACING_CAP_US. A
+ *     backlog after a stall is therefore replayed with its original spacing
+ *     (a press's 50 ms move pace and its 200 ms dwell stay intact). The idle
+ *     gaps between presses are shortened to the cap, which is how the
+ *     backlog drains. With no backlog the arrival gap has already elapsed,
+ *     so this adds no delay.
+ * Only when the queue holds VC_CONSOLIDATE_DEPTH events, one short of
+ * overflowing (ev_buf_full drops), does it consolidate as 0002 did: summing,
+ * but stopping at a button change. A single event over +-127 is clipped as
+ * before.
+ */
+#define VC_CONSOLIDATE_DEPTH 14
+#define VC_SPACING_CAP_US 250000
+uint32_t vc_last_sent_arrival;   // arrival time of the last event sent
+uint32_t vc_last_sent_at;        // micros() when it was taken off the queue
+uint8_t vc_sent_any;
+
+uint8_t vc_mouse_buf_depth(mouse_buf* mbuf)
+{
+  return (uint8_t)((mbuf->head + MOUSE_EVENT_BUFFER_SIZE - mbuf->tail) % MOUSE_EVENT_BUFFER_SIZE);
+}
+
+// May the event at the head of the queue go out now?
+uint8_t vc_spacing_ok(mouse_buf* mbuf, uint32_t now_us)
+{
+  if(!vc_sent_any || vc_mouse_buf_depth(mbuf) >= VC_CONSOLIDATE_DEPTH)
+    return 1;
+  uint32_t gap = vc_ev_arrival[mbuf->tail] - vc_last_sent_arrival;
+  if(gap > VC_SPACING_CAP_US)
+    gap = VC_SPACING_CAP_US;
+  return (now_us - vc_last_sent_at) >= gap;
+}
+
 uint8_t get_consolidated_mouse_event(mouse_buf* mbuf, mouse_event* cme_result)
 {
   uint8_t n = 0;
   uint8_t prev_buttons = 0;
+  uint8_t vc_one_only = vc_mouse_buf_depth(mbuf) < VC_CONSOLIDATE_DEPTH;
+  // The pacing reference is the arrival time of the FIRST event taken. When
+  // consolidating, the later ones are folded into its packet.
+  if(mouse_buf_peek(mbuf) != NULL)
+  {
+    vc_last_sent_arrival = vc_ev_arrival[mbuf->tail];
+    vc_last_sent_at = micros();
+    vc_sent_any = 1;
+  }
   cme_result->movement_x = 0;
   cme_result->movement_y = 0;
   cme_result->scroll_vertical = 0;
@@ -469,7 +536,7 @@ uint8_t get_consolidated_mouse_event(mouse_buf* mbuf, mouse_event* cme_result)
     // never OR-ed into a hold. Since 0002 holds an interrupted packet until it
     // completes, events can queue for longer behind it, which made this merge
     // more likely, not less. edge_merged therefore stays 0 by construction.
-    if(n > 0 && buttons != prev_buttons)
+    if(n > 0 && (buttons != prev_buttons || vc_one_only))
       break;
     prev_buttons = buttons;
     n++;
@@ -528,7 +595,11 @@ uint32_t last_mouse_movement;
  * The watchdog (IWDG, ~3.3 s) is safe: the main loop keeps running.
  */
 #define VC_RESUME_BYTE_WAIT_MS 2
-#define VC_RESUME_BUDGET_UNSENT_MS 1000
