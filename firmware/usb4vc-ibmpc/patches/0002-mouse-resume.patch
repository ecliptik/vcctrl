+/*
+ * vcctrl local patch 0002: RESUME an interrupted mouse packet; never abandon
+ * one half-sent.
+ *
+ * Stock firmware pops the queued events, builds one 3- or 4-byte packet and
+ * gives up on it the moment the host inhibits the clock mid-byte or holds the
+ * bus for more than 200 ms between bytes. When that happens after a byte has
+ * already gone out, the host has received part of a packet. CuteMouse 2.1b4
+ * keeps those bytes, so every later packet is read shifted by one or two
+ * bytes for as long as the driver runs. Measured on the Gateway 2000,
+ * 2026-11-11 (dosags rounds RJ, cells RJM1/RJM2): every click after the first
+ * pkt_partial landed at the screen's bottom-left until the cell ended.
+ *
+ * So the packet is kept, with the index of the next byte to send, until the
+ * host has every byte:
+ *   - host inhibits mid-byte (PS2_ERROR_HOST_INHIBIT): the host discards an
+ *     incomplete byte, so that SAME byte goes again, then the rest. That is
+ *     the PS/2 device rule.
+ *   - bus not idle (PS2_ERROR_TIMEOUT): wait for it and send the REMAINING
+ *     bytes. Bytes already clocked out were received; sending them again
+ *     would shift the frame exactly as abandoning did.
+ * The wait is NOT a blocking loop. Each pass tries for VC_RESUME_BYTE_WAIT_MS
+ * and then returns to the main loop, so the keyboard is still serviced while
+ * the mouse waits. Stock firmware blocked both for up to 200 ms per byte.
+ *
+ * Two ways a pending packet is still given up, both counted as a loss on the
+ * layout-1 page (pkt_inhibit / pkt_timeout, plus pkt_partial if any byte had
+ * gone out):
+ *   - the host sends a command (reset, disable, ...). A PS/2 device drops its
+ *     output on a host command, and the host re-synchronises on the reply.
+ *   - the wait budget runs out: VC_RESUME_BUDGET_UNSENT_MS if nothing had
+ *     gone out (nothing to desync, so this is as stock, only longer), or
+ *     VC_RESUME_BUDGET_PARTIAL_MS once a byte had (much longer, because
+ *     giving up then desynchronises the driver).
+ * The watchdog (IWDG, ~3.3 s) is safe: the main loop keeps running.
+ */
+#define VC_RESUME_BYTE_WAIT_MS 2
+#define VC_RESUME_BUDGET_UNSENT_MS 1000
+#define VC_RESUME_BUDGET_PARTIAL_MS 5000
+ps2_outgoing_buf vc_pend;
+uint8_t vc_pend_active;
+uint8_t vc_pend_idx;      // next byte to send
+uint8_t vc_pend_hit;      // interrupted at least once after starting
+uint32_t vc_pend_start;   // HAL_GetTick() when the packet was built
+
+void vc_pend_drop(uint8_t last_result)
+{
+  if(last_result == PS2_ERROR_HOST_INHIBIT)
+    vc_mouse_stats[VC_PKT_INHIBIT]++;
+  else
+    vc_mouse_stats[VC_PKT_TIMEOUT]++;
+  if(vc_pend_idx > 0)
+    vc_mouse_stats[VC_PKT_PARTIAL]++;
+  vc_pend_active = 0;
+  last_mouse_movement = micros();
+}
+
+void vc_pend_service(void)
+{
+  uint8_t r = PS2_OK;
+  PCARD_BUSY_HI();
+  while(vc_pend_idx < vc_pend.size)
+  {
+    r = ps2mouse_write(vc_pend.data[vc_pend_idx], VC_RESUME_BYTE_WAIT_MS);
+    if(r == PS2_OK)
+    {
+      vc_pend_idx++;
+      continue;
+    }
+    // A wait before the FIRST byte is ordinary bus traffic, as in stock
+    // firmware; only an interruption once the packet has started is a resume.
+    if(vc_pend_idx > 0 || r == PS2_ERROR_HOST_INHIBIT)
+      vc_pend_hit = 1;
+    if(r == PS2_ERROR_HOST_INHIBIT)
+      vc_resume_stats[VC_R_INHIBIT_RETRY]++;
+    if(vc_pend_idx > 0)
+      vc_resume_stats[VC_R_PARTIAL_WAITS]++;
+    uint32_t budget = vc_pend_idx ? VC_RESUME_BUDGET_PARTIAL_MS : VC_RESUME_BUDGET_UNSENT_MS;
+    if(HAL_GetTick() - vc_pend_start > budget)
+    {
+      vc_resume_stats[VC_R_ABANDON_BUDGET]++;
+      vc_pend_drop(r);
+    }
+    PCARD_BUSY_LOW();
+    return;   // try again on the next pass; the keyboard gets its turn first
+  }
+  vc_mouse_stats[VC_PKT_OK]++;
+  if(vc_pend_hit)
+  {
+    vc_resume_stats[VC_R_PKT_RESUMED]++;
+    uint32_t w = HAL_GetTick() - vc_pend_start;
+    if(w > 0xffff)
+      w = 0xffff;
+    if(w > vc_resume_stats[VC_R_MAX_WAIT_MS])
+      vc_resume_stats[VC_R_MAX_WAIT_MS] = (uint16_t)w;
+  }
+  vc_pend_active = 0;
+  last_mouse_movement = micros();
+  PCARD_BUSY_LOW();
+}
+
